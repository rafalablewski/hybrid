# dependencies
node_modules/
.pnp.*
.yarn/*

# builds
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# expo
.expo/
.expo-shared/
*.orig.*
web-build/
ios/
android/
# ...but DO track hand-written native sources for local Expo modules (the
# generated app-level ios/ above stays ignored; these are real source files).
!apps/mobile/modules/**/ios/
!apps/mobile/modules/**/ios/**
expo-env.d.ts

# env / secrets — NEVER commit
.env
.env.*
!.env.example
# Apple signing keys (App Store Connect API .p8) — secret, env-var only
*.p8
# Apple distribution certificate (.p12) — secret, env-var only
*.p12
# Fastlane / native build artifacts
apps/mobile/build/
apps/mobile/fastlane/report.xml
apps/mobile/fastlane/Preview.html
apps/mobile/fastlane/test_output/

# editor / os
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
pnpm-debug.log*

# vercel
.vercel
