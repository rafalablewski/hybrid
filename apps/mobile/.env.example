# HYBRID mobile (Expo) — environment variables.
# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* vars are read by the app, and
# they are EMBEDDED IN THE BUNDLE — so these are public, never put secrets here.

# The backend the app calls (same Vercel host the web app runs on).
EXPO_PUBLIC_API_URL="https://hybrid-web-rosy.vercel.app"

# The auto-renewable subscription product id for the Full upgrade. Must match
# APPLE_IAP_PRODUCT_FULL on the server AND the Product ID in App Store Connect.
EXPO_PUBLIC_IAP_PRODUCT_FULL="com.hybrid.full.monthly"
