# HYBRID — environment variables.
# Copy to .env (and set the same in Vercel → Project → Settings → Environment
# Variables). NEVER commit real values. NEXT_PUBLIC_* are exposed to the browser.

# --- Supabase (Sprint 1) ---------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only. Never exposed to the browser; used by trusted server code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database / Prisma (Sprint 1) ------------------------------------------
# Project → Settings → Database → Connection string.
# DATABASE_URL = pooled (PgBouncer, port 6543, add ?pgbouncer=true) for the app.
# DIRECT_URL   = direct (port 5432) for prisma migrate.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- AI coach (later sprint) -----------------------------------------------
# Server-side only — never call Anthropic from a client.
ANTHROPIC_API_KEY="sk-ant-..."
