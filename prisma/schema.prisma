// HYBRID data model — Sprint 1.
// Postgres on Supabase. The permission model lives HERE (roles + CoachLink),
// not in the UI. Row-level security is enforced in Supabase / API middleware:
//   - a user reads/writes Session, Macrocycle, Biometric only WHERE userId = auth.uid()
//   - a coach reads a client's data only via an ACTIVE CoachLink
//   - private CoachNotes are never returned to the client
//   - admins read aggregates only — never another user's raw private rows

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for the app; direct connection for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum LinkStatus {
  PENDING
  ACTIVE
  ENDED
}

model User {
  id        String   @id @default(cuid())
  // Mirrors the Supabase auth.users id so RLS can match auth.uid().
  authId    String?  @unique
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT) // a user can be COACH and CLIENT at once
  language  String   @default("en")
  createdAt DateTime @default(now())

  // A COACH whose credentials an admin has vetted — surfaced as a "verified"
  // tick on the coach's profile wherever a client sees them. Set true when an
  // admin approves a coach application (or toggles it on the user record);
  // ignored for non-coaches.
  coachVerified Boolean @default(false)

  // Billing — the paid "Full" entitlement. entitlement is mirrored into the
  // Supabase auth user_metadata so both clients read it from the session; these
  // columns are the server-side source of truth + the Stripe linkage.
  entitlement                String    @default("free") // free | paid
  stripeCustomerId           String?   @unique
  subscriptionStatus         String? // active | trialing | past_due | canceled | null
  // Timestamp (Stripe event.created) of the last applied subscription event, so
  // a delayed/out-of-order webhook can't roll the entitlement back to a stale
  // state (e.g. a late "deleted" landing after a re-subscribe).
  subscriptionStatusAt       DateTime?
  // The Apple originalTransactionId that granted Full, if via IAP. Unique so a
  // (cryptographically valid) StoreKit transaction can be redeemed by exactly
  // one account — prevents replay / cross-account sharing of one purchase.
  appleOriginalTransactionId String?   @unique

  // The athlete's training maxes (1RMs) the discipline-shaped plans derive
  // working loads from — a flat { liftKey: 1RM } map keyed by ProgramInput.key
  // (e.g. {"snatch":100,"backSquat":200}). Read/written via /api/plan-maxes and
  // mirrored on each device so "Your plan today" shows working kg everywhere.
  // Soft-guarded (raw queries) so the app runs before the column is migrated
  // (reference/sql-plan-maxes.sql).
  planMaxes Json @default("{}")

  // THE QUESTIONNAIRE — everything the athlete has told the app about
  // themselves: sex, age, height, body mass, training age, years lifting,
  // sessions per week, typical sleep and stress, energy intake. Shape and
  // validation are `sanitizeVolumeProfile` in packages/core (one definition of
  // a legal answer, shared by the clients and this column's API).
  //
  // It lived ONLY in each device's own storage until Aug 2026, which had two
  // consequences worth naming. It did not follow the athlete between devices,
  // so one person got two different volume models. And the SERVER could not
  // read it — which mattered most for `sex`, because every strength and pace
  // threshold in the app is published for a male athlete and shifted from
  // there, so a public badge scored against the men's bar while her own card
  // scored her correctly. Two surfaces disagreeing about the same person.
  //
  // Read/written via /api/questionnaire and mirrored on each device. Soft-
  // guarded (raw queries) so the app runs before the column is migrated
  // (reference/sql-questionnaire.sql).
  questionnaire Json @default("{}")

  sessions          Session[]
  // The queryable projections of those sessions (see SessionSet). Denormalised
  // with a userId of their own so a cross-athlete aggregate never joins Session.
  sessionSets       SessionSet[]
  sessionStreams    SessionStream[]
  sessionLaps       SessionLap[]
  macrocycles       Macrocycle[]
  biometrics        Biometric[]
  signals           Signal[]
  connections       Connection[]
  rtpProtocols      RtpProtocol[]
  riskOutcomes      RiskOutcome[]
  checkins          Checkin[]
  checkinReads      CheckinRead[]
  // ---- Profile "Private" tab (owner-only self-tracking) ----
  bodyMetrics       BodyMetric[]
  journalEntries    JournalEntry[]
  hiddenHighlights  HiddenHighlight[]
  highlightOrder    HighlightOrder?
  notificationState NotificationState?
  pushDevices       PushDevice[]
  templates         WorkoutTemplate[]
  savedMeals        SavedMeal[]
  foodProducts      FoodProduct[]
  foodLogs          FoodLog[]
  userRecipes       UserRecipe[]
  planDayOverrides  PlanDayOverride[]
  assignments       Assignment[]       @relation("assignmentAthlete")
  assignmentsMade   Assignment[]       @relation("assignmentCoach")
  coachLinks        CoachLink[]        @relation("asClient")
  clientLinks       CoachLink[]        @relation("asCoach")
  coachGroups       CoachGroup[]       @relation("coachGroups")
  coachPrograms     CoachProgram[]     @relation("coachPrograms")
  coachInvites      CoachInvite[]      @relation("coachInvites")
  coachDiets        CoachDiet[]        @relation("coachDiets")
  adminAudits       AdminAudit[]       @relation("adminAuditActor")

  // ---- Social layer + coach marketplace ----
  socialProfile         SocialProfile?
  coachProfile          CoachProfile?
  follows               Follow[]            @relation("follower") // people I follow
  followers             Follow[]            @relation("followee") // people who follow me
  kudosGiven            Kudos[]             @relation("kudosGiver")
  kudosReceived         Kudos[]             @relation("kudosOwner")
  attestationsOwned     RecordAttestation[] @relation("attestationOwner")
  attestationsWitnessed RecordAttestation[] @relation("attestationWitness")
  commentsAuthored      Comment[]           @relation("commentAuthor")
  commentsReceived      Comment[]           @relation("commentOwner")
  blocksMade            Block[]             @relation("blocker")
  blocksReceived        Block[]             @relation("blocked")
  posts                 Post[]
  savedPosts            SavedPost[]
  enrollments           ProgramEnrollment[] @relation("enrollClient") // programs I started
  coachEnrollments      ProgramEnrollment[] @relation("enrollCoach") // enrolments into my programs
  reviewsReceived       CoachReview[]       @relation("reviewCoach") // reviews of me as a coach
  reviewsAuthored       CoachReview[]       @relation("reviewAuthor") // reviews I wrote

  // Admin lists order/filter users by recency (admin/users, admin/stats growth).
  @@index([createdAt])
}

// A user's application to become a COACH. Admin approves → the user's role is
// promoted to COACH. Free-text credentials say who they are / certs / why.
model CoachApplication {
  id          String    @id @default(cuid())
  userId      String    @unique
  userEmail   String
  credentials String // free-text: who they are / certs / why
  status      String    @default("pending") // pending | approved | denied
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([status])
}

// The mutual-consent coach↔client relationship. Authorization is by THIS,
// not by role label alone.
model CoachLink {
  id        String      @id @default(cuid())
  coach     User        @relation("asCoach", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  client    User        @relation("asClient", fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  status    LinkStatus  @default(PENDING)
  tags      String[]    @default([]) // coach-authored labels for roster segmentation
  createdAt DateTime    @default(now())
  notes     CoachNote[]

  @@unique([coachId, clientId])
  @@index([clientId])
  @@index([coachId])
}

// A solo coach's lightweight client GROUP (e.g. "Tuesday 6am squad") — a named
// set of the coach's clients, so a coach can assign a whole plan to all of them
// at once. This is the ONLY grouping primitive — the enterprise Org Graph that
// modelled institutions was cut (2026-08). Members are stored as client user ids and each is
// re-validated against an ACTIVE CoachLink at assign time (membership is not a
// grant on its own).
model CoachGroup {
  id        String   @id @default(cuid())
  coach     User     @relation("coachGroups", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  name      String
  clientIds String[] @default([])
  createdAt DateTime @default(now())

  @@index([coachId])
}

// A coach-authored multi-week PROGRAM (type 3 of the plan model — see the
// plans-lib capability): the coach composes weeks → days → exercises once, then
// assigns it to a client or a whole group, which materializes it into dated
// Assignments. `weeks` is a JSON PlanSample[][] (weeks of days of items), reusing
// the core plan shape so planDayToBlocks() can turn each day into session blocks.
model CoachProgram {
  id         String   @id @default(cuid())
  coach      User     @relation("coachPrograms", fields: [coachId], references: [id], onDelete: Cascade)
  coachId    String
  name       String
  goal       String?
  weeks      Json     @default("[]")
  // Marketplace listing: when published, the program appears on the coach's
  // public storefront and any user can start it (client-initiated enrolment →
  // ProgramEnrollment + a CoachLink). summary/level are storefront copy.
  published  Boolean  @default(false)
  summary    String?
  level      String? // "beginner" | "intermediate" | "advanced" | free text
  visibility String   @default("public") // public | link (unlisted, link-only)
  createdAt  DateTime @default(now())

  enrollments ProgramEnrollment[]

  @@index([coachId])
  @@index([published])
}

// ---- Social layer (handles · follow graph · feed reactions) --------------
// A user's PUBLIC social identity — distinct from the private User row. Holds
// the @handle, profile copy and the privacy gate for results. 1:1 with User
// (own its row), the same separate-table pattern as OnboardingState
// so the hot-path user lookup never depends on it. See reference/sql-social.sql.
model SocialProfile {
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @id
  handle      String   @unique // public @name; lowercase [a-z0-9_], 3–20
  displayName String?
  bio         String?
  avatarUrl   String?
  // Who can see this athlete's RESULTS (feed, leaderboard, compare). The profile
  // card + handle stay searchable regardless; this gates the data behind it.
  // PUBLIC is the app's default — every finished workout publishes to the feed
  // automatically, and the athlete opts DOWN to followers-only or private.
  visibility  String   @default("public") // public | followers | private
  showcase    Json     @default("{}") // pinned highlight stats (client-curated)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([handle])
}

// The asymmetric follow edge. A FRIEND is a mutual active follow (derived, no
// extra table). closeFriend is the follower's curated inner circle — they top
// the feed and can see a touch more. A follow of a `private` profile lands
// PENDING until the target approves.
model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  followee    User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  followeeId  String
  status      String   @default("active") // active | pending
  closeFriend Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

// A kudos (like) on a feed subject. Subjects are derived items keyed by
// (subjectType, subjectId) — e.g. ("session", sessionId) — so we don't have to
// materialize a posts table. ownerId is the subject's author (for fan-out +
// notifications). One kudos per giver per subject.
model Kudos {
  id          String   @id @default(cuid())
  giver       User     @relation("kudosGiver", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  owner       User     @relation("kudosOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  subjectType String // session | pr | recap | badge
  subjectId   String
  createdAt   DateTime @default(now())

  @@unique([userId, subjectType, subjectId])
  @@index([ownerId, subjectType, subjectId])
}

// A saved (bookmarked) feed post. Anchored like Kudos — (subjectType,
// subjectId) — but with ONE party: a save is private, nobody is notified, and
// the author has no claim on the row, so unlike Kudos there is no ownerId.
//
// No FK to Session/Post on purpose: a "pr" row's subjectId is the SESSION the
// PR was set in, so one id column would need two FK targets, and the feed's
// subjects are derived rather than one table. The read path re-checks existence
// and visibility on every load (/api/social/saved), so a dangling row already
// has a defined outcome — it returns as `gone` and the client drops it.
//
// SQL: reference/sql-saved-post.sql.
model SavedPost {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  subjectType String // session | pr | post
  subjectId   String
  savedAt     DateTime @default(now())

  // Saving twice is saving once — which is what makes the cross-device merge a
  // plain union: a device pushes its whole list without deduping first.
  @@unique([userId, subjectType, subjectId])
  // The only read: "my shelf, newest save first."
  @@index([userId, savedAt])
}

// A comment on a feed subject (same subject anchoring as Kudos).
model Comment {
  id          String   @id @default(cuid())
  author      User     @relation("commentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  owner       User     @relation("commentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  subjectType String
  subjectId   String
  body        String
  createdAt   DateTime @default(now())

  @@index([ownerId, subjectType, subjectId])
  @@index([userId])
}

// The Verified Strength Record's tier-2 evidence: one witness request / co-sign
// on ONE lift in ONE session. Anchored like Kudos — (sessionId, lift) is the
// subject — with the claim SNAPSHOTTED at request time (e1rm/topLoad in kg), so
// what the witness signed can never drift under them if the session is edited.
// Append-only by convention: the snapshot never changes; status moves once,
// pending → cosigned | declined, stamped with respondedAt. Tier grading lives
// in core/attestation.ts; a PR is "witnessed" only while a cosigned row exists.
model RecordAttestation {
  id          String    @id @default(cuid())
  owner       User      @relation("attestationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String // the lifter whose PR this is
  witness     User      @relation("attestationWitness", fields: [witnessId], references: [id], onDelete: Cascade)
  witnessId   String // the co-signer staking their name
  sessionId   String // the session the lift was logged in (owner's)
  lift        String // the lift name exactly as logged in the strength block
  e1rm        Float? // claim snapshot at request time, kg
  topLoad     Float? // claim snapshot at request time, kg
  status      String    @default("pending") // pending | cosigned | declined
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([sessionId, lift, witnessId])
  @@index([witnessId, status])
  @@index([ownerId, createdAt])
  @@index([sessionId])
}

// A first-class feed POST — a status update or a shared card (a PR, a workout).
// Distinct from the DERIVED feed items (sessions/PRs): a post is something the
// user chose to share. Reactions reuse the (subjectType, subjectId) anchoring
// with subjectType "post". `data` carries the card payload (e.g. { lift, e1rm }).
model Post {
  id        String   @id @default(cuid())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  kind      String   @default("status") // status | pr | workout
  text      String? // caption / status text
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([authorId, createdAt])
}

// A user blocking another — mutual invisibility: blocked pairs never see each
// other in the feed, search, suggestions, leaderboards or compare, and can't
// follow. Creating a block also tears down any follow edges between them.
model Block {
  id        String   @id @default(cuid())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ---- Coach marketplace (storefront · enrolment · reviews) ----------------
// A coach's public STOREFRONT — the marketing profile shown in the directory.
// Separate from SocialProfile (a coach is also an athlete; the shared @handle
// lives on SocialProfile). 1:1 with User. See reference/sql-social.sql.
model CoachProfile {
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String   @id
  headline         String?
  bio              String?
  specialties      String[] @default([]) // e.g. ["Olympic lifting", "Fat loss"]
  sports           String[] @default([])
  acceptingClients Boolean  @default(true)
  autoAccept       Boolean  @default(false) // auto-activate enrolment without manual accept
  priceNote        String? // free-text until billing ships (paid checkout is blocked)
  visibility       String   @default("public") // public | unlisted
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

// A client STARTING an online program with a coach (client-initiated, the
// inverse of CoachInvite). Creating one opens a CoachLink (PENDING, or ACTIVE
// when the coach set autoAccept) — the link is the authorization, this row
// tracks the program enrolment itself.
model ProgramEnrollment {
  id        String       @id @default(cuid())
  program   CoachProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
  coach     User         @relation("enrollCoach", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  client    User         @relation("enrollClient", fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  status    String       @default("requested") // requested | active | ended | declined
  linkId    String? // the CoachLink this enrolment created/uses
  startedAt DateTime?
  createdAt DateTime     @default(now())

  @@unique([programId, clientId])
  @@index([coachId])
  @@index([clientId])
}

// A client's rating + review of a coach. Only an athlete with an active/ended
// CoachLink may review (enforced in the API). One review per coach↔author pair.
model CoachReview {
  id        String   @id @default(cuid())
  coach     User     @relation("reviewCoach", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  author    User     @relation("reviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  rating    Int // 1–5
  body      String?
  createdAt DateTime @default(now())

  @@unique([coachId, authorId])
  @@index([coachId])
}

// A pre-account invite from a coach to a prospective client who isn't on HYBRID
// yet. Three delivery methods share ONE invite: a QR code, a copyable link, or
// (later) email/SMS. The client CLAIMS it — by scanning the QR / opening the
// link, or an email auto-match on first sign-up — which creates an ACTIVE
// CoachLink (the act of claiming is the consent). Single-use + expiring. The
// claimed client lands on the free plan with read-only access to what the coach
// assigns. See reference/sql-coach-invites.sql (soft-degrades until run).
model CoachInvite {
  id          String   @id @default(cuid())
  coach       User     @relation("coachInvites", fields: [coachId], references: [id], onDelete: Cascade)
  coachId     String
  token       String   @unique // random; encodes the link + QR, also the claim key
  email       String? // optional auto-match target (verified email on signup)
  phone       String? // optional auto-match target (future SMS)
  status      String   @default("PENDING") // PENDING | CLAIMED | REVOKED
  claimedById String? // the user who claimed it
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([coachId])
  @@index([email])
}

// A coach-assigned DIET (macro targets) for one client — the nutrition analogue
// of an assigned training plan. The client VIEWS it read-only on their Nutrition
// screen (alongside their own free macro logging); editing their own adaptive
// targets is still the paid upgrade. One active diet per coach↔client pair, only
// honoured while an ACTIVE CoachLink exists. See reference/sql-coach-diet.sql.
model CoachDiet {
  id        String   @id @default(cuid())
  coach     User     @relation("coachDiets", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  clientId  String // the athlete this diet is for
  kcal      Int?
  protein   Int? // grams/day
  carbs     Int? // grams/day
  fat       Int? // grams/day
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([coachId, clientId])
  @@index([clientId])
}

// The daily check-in — a personal training-readiness log. The client submits a
// structured self-report + a note each day; by default it's for their own use.
// A paid athlete may share a check-in with their coach, who then reads/replies
// via an ACTIVE CoachLink. Authored by the client (userId).
model Checkin {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  weekOf          DateTime // the day this check-in covers (midnight-normalized); legacy name
  bodyMassKg      Float?
  energy          Int? // 1–5 self-report
  sleep           Int? // 1–5
  // MISLEADING NAME, kept for compatibility: this column stores FRESHNESS, not
  // soreness. The guided flow asks "How fresh do your muscles feel?" and every
  // writer follows that sense, so 5 = muscles feel fresh and 1 = wrecked.
  // Read it through core/checkin-scales.ts (sorenessFromCheckin) — reading it
  // by its name is how the volume estimator once shipped inverted.
  soreness        Int? // 1–5 (5 = FRESH, 1 = very sore)
  mood            Int? // 1–5
  adherencePct    Int? // self-reported plan adherence 0–100
  note            String? // client free text
  coachReply      String? // coach response
  repliedAt       DateTime?
  // The daily check-in is for the athlete's own use by default; only a paid
  // athlete may opt to SHARE a check-in with their coach. A coach reads a
  // client's check-ins via an ACTIVE CoachLink AND only where this is true.
  sharedWithCoach Boolean   @default(false)
  createdAt       DateTime  @default(now())

  /// Every readiness answer given on this day, oldest first — see CheckinRead.
  reads CheckinRead[]

  // Read as "where userId order by weekOf desc".
  @@index([userId, weekOf])
  // Coach views read a client's SHARED check-ins.
  @@index([userId, sharedWithCoach])
}

/// ONE ANSWER PER MOMENT, NOT ONE PER DAY.
///
/// Checkin holds one row per day, and "how ready do you feel?" lived in its
/// `energy` column alone — so an athlete answering again hours later could only
/// OVERWRITE the morning's answer, and the card locked the faces rather than let
/// that happen. Both were wrong the same way: "flat ninety minutes after squats"
/// and "flat fourteen hours later" are not one answer someone got wrong the
/// first time. They are two measurements, and the second is the one that should
/// move training — while the first is what makes the second interpretable (the
/// drop between them, against the population decay curve, is a direct read of
/// this athlete's own recovery rate).
///
/// So each answer is APPENDED here with its own clock, and the day's Checkin
/// keeps the DECISIVE read (the latest one not taken in the shadow of a session)
/// in `energy` — so every existing reader of that column keeps working and needs
/// no migration. The maths lives in packages/core/src/readiness-reads.ts.
model CheckinRead {
  id            String   @id @default(cuid())
  checkin       Checkin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  checkinId     String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  /// Which question this answers. "energy" is the readiness face on Today —
  /// named for the Checkin column it lands in so the two can't drift.
  metric        String   @default("energy")
  /// 1–5 as answered (5 = primed).
  value         Int
  /// When it was answered. The whole point of the row.
  loggedAt      DateTime @default(now())
  /// Hours since the session that ended before it, stamped at write time from
  /// the client's own session list. Null when the athlete hadn't trained, or
  /// when no session carried a usable clock — never a guess.
  sinceSessionH Float?

  // Read as "this athlete's reads, newest first" and "this day's reads".
  @@index([userId, loggedAt])
  @@index([checkinId])
}

// ── Profile "Private" tab (owner-only; RLS in reference/sql-private-tab.sql) ──

// Dated body-composition + tape measurements (the "Body & progress" block).
// Bodyweight is also captured via Checkin/Signal; this is the measurements store.
model BodyMetric {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  measuredAt DateTime @default(now())
  weightKg   Float?
  // Standing height. Effectively static for an adult, but it lives here with
  // the other tape measurements rather than on User because it genuinely does
  // change for a growing athlete, and the latest reading is what any consumer
  // wants. Used to normalise the volume model's body-mass factor: comparing an
  // athlete's mass to what their height predicts is fairer than comparing raw
  // kilos, which penalise a tall lean lifter and a short heavy one alike.
  heightCm   Float?
  bodyFatPct Float?
  neckCm     Float?
  chestCm    Float?
  waistCm    Float?
  hipsCm     Float?
  thighCm    Float?
  armCm      Float?
  calfCm     Float?
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, measuredAt])
}

// Private free-text notes/reflections (the "Journal" block). Owner-only.
model JournalEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, createdAt])
}

// The set of earned PRs/badges the owner keeps OFF the public grid. `key` is the
// highlight's stable id, e.g. "pr:deadlift", "badge:100-day-streak".
model HiddenHighlight {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

// The owner's chosen arrangement of the public Overview highlight tiles. A single
// row per user holding the ordered list of tile keys (same stable ids as
// HiddenHighlight, e.g. "pr:deadlift", "streak"). The grid reconciles this
// against the tiles that currently have data: known keys render in this order,
// any newly-earned key not yet listed appends at the end.
model HighlightOrder {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  keys      String[]
  updatedAt DateTime @updatedAt
}

// Which notifications this ACCOUNT has seen, held unread, or thrown away — the
// server-side home of @hybrid/core's NotifReadState (packages/core/notifications.ts),
// one row per user. It began per-device (localStorage / AsyncStorage) on the
// logger-prefs contract, and that held right up until a row could be DELETED: a
// badge that disagrees across devices is a nuisance, but a notification you threw
// away on the phone reappearing on the laptop is the app forgetting something you
// told it. Clients write DECISIONS (NotifOp) through /api/notifications/state and
// keep their local copy as an offline cache, so two devices never have to have
// their states merged — the server applies the ops in arrival order.
//
// `seenAt` is the watermark (everything stamped at or before it is read); the
// three id sets are the exceptions a watermark can't express — see the engine.
// Each is bounded to NOTIF_READ_ID_CAP (200) by the reducer, so the row stays
// small: a read state is not a log. reference/sql-notification-state.sql.
model NotificationState {
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @id
  seenAt       DateTime?
  readIds      String[]  @default([])
  unreadIds    String[]  @default([])
  dismissedIds String[]  @default([])
  updatedAt    DateTime  @updatedAt
}

// One phone that has agreed to be interrupted — the other half of the bell.
//
// NotificationState above is what you have SEEN; this is where something can be
// SENT. Three notifications use it (core/push.ts): the morning readiness nudge,
// a coach assignment, and a co-sign request. reference/sql-push-device.sql.
//
// WHY THE ROW CARRIES SO MUCH BESIDES THE TOKEN:
//   • timezone — the nudge aims at the ATHLETE's 07:00. 07:00 UTC is 02:00 in
//     Los Angeles, and one notification at two in the morning spends the
//     permission for good.
//   • locale — iOS renders a push from what the SERVER sent, so the server has
//     to know the language. The device reports it at registration.
//   • the three switches — a MIRROR of user_metadata.notifications (the account
//     is still the source of truth, and every launch re-mirrors). The sender
//     needs them in a WHERE clause; reading auth metadata per user would be an
//     admin round-trip per recipient, which the hourly cron cannot afford.
//   • environment — which APNs host answered for this token. Unknown until the
//     first send, then remembered, so later sends skip the sandbox retry.
//   • lastNudgeAt / nudgeStreak — the nudge's own bookkeeping: one per local
//     day, and it stops after NUDGE_GIVE_UP unanswered mornings. A daily prompt
//     to somebody who has stopped answering is how a whole app gets muted.
//   • retiredAt — APNs said the token is dead (410 Unregistered / a bad token).
//     Kept rather than deleted: the same device re-registers on next launch and
//     the row is revived, so the history (and the streak) survives a reinstall.
model PushDevice {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  /// The APNs device token (hex). Unique across users: a phone handed to another
  /// athlete re-registers the same token, and it must not then get both feeds.
  token          String    @unique
  platform       String    @default("ios")
  /// "production" | "sandbox" | null (not yet known — see the sender's retry).
  environment    String?
  /// IANA zone, e.g. "Europe/Warsaw". Null = the nudge can't be timed; skipped.
  timezone       String?
  /// BCP-47 as reported by the device ("pl", "de-DE"). Null = English.
  locale         String?
  notifyCheckin  Boolean   @default(true)
  notifyCoach    Boolean   @default(true)
  notifyCosign   Boolean   @default(true)
  lastPushAt     DateTime?
  lastNudgeAt    DateTime?
  nudgeStreak    Int       @default(0)
  retiredAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // "every live device for this athlete" (the sender) and "every live device due
  // a nudge" (the cron, which then filters by local hour in JS).
  @@index([userId, retiredAt])
  @@index([retiredAt, notifyCheckin])
}

// A reusable workout the coach (or athlete) builds once and assigns many times.
model WorkoutTemplate {
  id          String   @id @default(cuid())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  name        String
  description String?
  blocks      Json // SessionBlock[]
  // Starred by the owner → floated to the Quick-start sheet's Favourites rail.
  // Added via reference/sql-routine-favourite.sql; read/written through guarded
  // raw queries so the app runs safely before the column is migrated (mirrors the
  // planMaxes soft-guard idiom). Never selected by the hot findMany/findUnique
  // reads — the GET merges it via a separate guarded sub-query.
  favourite   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// A reusable MEAL the user built themselves (name + single-number macros), saved
// to their personal Nutrition library for one-tap logging. Free users keep up to
// FREE_MEAL_LIMIT (access.ts); Full is unlimited — the API gates POST on
// access.canSaveMeal. kcal is stored explicitly (may be user-entered or derived
// 4·4·9 from the macros) so a logged meal matches its saved total exactly.
model SavedMeal {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  subname   String? // the user's personal label ("w/ sushi rice", "the usual way")
  emoji     String? // a single glyph for the tile (🍳/🥗/…)
  kcal      Int
  protein   Int // grams
  carbs     Int // grams
  fat       Int // grams
  // The LABEL PANEL (packages/core/src/food-facts.ts) — optional because most
  // foods never state it. NULL means NOT STATED and must never render as 0 g.
  satFat    Float? // "of which saturates", grams
  sugar     Float? // "of which sugars", grams
  fiber     Float? // dietary fibre, grams
  salt      Float? // grams (the EU label unit; sodium is derived)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A custom FOOD PRODUCT the user added (a reusable food with per-serving macros)
// — the personal, offline half of the (blocked) food database. Full-only: the
// API gates POST on access.canSaveProduct. Building a meal picks products and
// sums their macros. servingLabel is free text ("100 g", "1 scoop", "1 med").
model FoodProduct {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  subname      String? // the user's personal label ("w/ sushi rice", "the usual way")
  servingLabel String   @default("1 serving")
  /**
   * the serving's weight in grams when known — enables per-100 g comparison
   */
  servingGrams Float?
  /**
   * THE FOOD'S NAMED PORTIONS — [{ label, size, source }], size in the
   * serving's own measure (grams for a food sold by weight, millilitres for one
   * sold by volume). A LIST, because real foods have several: a cheese has a
   * slice and a block. `source` records where each came from — catalog (Open
   * Food Facts publishes the net quantity), scanned, learned or typed — so a
   * figure the catalog published is never confused with one the athlete
   * corrected. See packages/core/src/portion.ts.
   */
  portions     Json     @default("[]")
  /**
   * LEGACY, read-only: the SINGLE pack the first cut of portions stored, before
   * it was clear that asking the athlete could never scale past a handful of
   * foods. Folded into `portions` at read time (core foodPortions) so nothing
   * already recorded is lost. Nothing writes these any more.
   */
  packSize     Float?
  packLabel    String?
  kcal         Int
  protein      Int // grams per serving
  carbs        Int // grams per serving
  fat          Int // grams per serving
  // The LABEL PANEL (packages/core/src/food-facts.ts) — NULL = not stated.
  satFat       Float?
  sugar        Float?
  fiber        Float?
  salt         Float?
  /**
   * the HYBRID Verified catalog id this was saved from (provenance), if any
   */
  verifiedId   String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// A recipe the ATHLETE authored — as opposed to the curated read-only library
// in packages/core/src/recipes.ts, which is editorial content and has no rows.
//
// The distinction that shapes this model: a user recipe's macros are DERIVED,
// never typed. Nobody knows the macros of the pasta they invented; they know
// what went into it. So the recipe itself stores no nutrition at all — every
// figure comes from summing its ingredients through @hybrid/core's
// user-recipes.ts (which routes through food-facts.sumFacts, so the
// not-stated-is-not-zero rule holds for a recipe total exactly as it does for a
// day total). Owner-scoped; free users keep up to access.FREE_RECIPE_LIMIT.
model UserRecipe {
  id          String                 @id @default(cuid())
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  /// the athlete's own note ("the way Mum makes it", "double the chilli")
  note        String?
  emoji       String?
  /// how many servings the ingredient list as written produces
  servings    Int                    @default(1)
  /// active time in minutes, when the athlete recorded it
  timeMins    Int?
  ingredients UserRecipeIngredient[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, updatedAt])
}

// One line of a recipe: a food, and how much of it went in.
//
// The facts are a SNAPSHOT, stored even when productId/verifiedId link the line
// back to its source. Two reasons pulling the same way: a deleted product must
// not silently under-total a recipe (a confident wrong number is the exact
// failure the not-stated rule exists to prevent), and a recipe is a record of
// what you MADE — correcting a product in March did not change the food you ate
// in February. The link survives for provenance and for staleIngredients(),
// which reports drift so the athlete can refresh it deliberately.
model UserRecipeIngredient {
  id           String     @id @default(cuid())
  recipe       UserRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId     String
  /// the name as it read when the ingredient was added — always stored, so a
  /// deleted product leaves a named line rather than a blank one
  name         String
  /// how many of the source's servings went in (2.5 × "100 g" = 250 g)
  qty          Float      @default(1)
  /// the source's own serving label, e.g. "100 g", "1 scoop"
  servingLabel String     @default("1 serving")
  // The snapshot, per ONE serving of the source. NULL = not stated, never zero.
  kcal         Float
  protein      Float
  carbs        Float
  fat          Float
  satFat       Float?
  sugar        Float?
  fiber        Float?
  salt         Float?
  /// TRUE when this line's numbers are NOT KNOWN — the name and the quantity
  /// are real, the four macro columns above are placeholder zeros, and nothing
  /// may read them as a measurement. It is how a copied or imported line that
  /// found no food stating its numbers is stored honestly; recipeTotals leaves
  /// it out and names it, and the recipe refuses to be logged until it clears.
  /// See @hybrid/core user-recipes.ts.
  unstated     Boolean    @default(false)
  /// the saved FoodProduct this came from, if any (provenance + staleness)
  productId    String?
  /// the HYBRID Verified catalog id this came from, if any
  verifiedId   String?
  position     Int        @default(0)

  @@index([recipeId, position])
}

// One logged food/meal entry — the editable, deletable record behind a day's
// intake. The engines still read the mirrored Signals (energyIntake + the three
// macros); THIS row is what the Diary lists and what edit/delete operate on.
// Macros are stored PER SINGLE SERVING with a separate `qty`, so a quantity edit
// rescales the mirror cleanly. `signalIds` links the four mirrored Signals for
// an atomic delete. Owner-scoped (same own-rows RLS as Signal); soft-guarded on
// the server so logging still works before reference/sql-nutrition-log.sql runs.
model FoodLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  subname    String? // brand / serving label, shown under the name
  source     String // the part of the day (breakfast | lunch | dinner | snack | custom)
  kcal       Float // per single serving
  protein    Float // grams per serving
  carbs      Float // grams per serving
  fat        Float // grams per serving
  // The LABEL PANEL, per single serving (packages/core/src/food-facts.ts).
  // NULL = the food never stated it — the diary shows "—", not "0 g".
  satFat     Float?
  sugar      Float?
  fiber      Float?
  salt       Float?
  /**
   * the HYBRID Verified catalog id this entry came from (provenance), if any
   */
  verifiedId String?
  qty        Float    @default(1) // number of servings logged
  /**
   * WHAT THE ATHLETE ACTUALLY ENTERED, and the unit they entered it in — 35
   * "g", 1 "bottle", 1.5 "serving". `qty` still drives every total; this is the
   * record of how the portion was expressed, so the diary row can say "35 g"
   * instead of "0.35". A quantity edit rescales it by the same ratio. NULL on
   * entries logged before this shipped, and on paths with no amount to record.
   * See packages/core/src/portion.ts.
   */
  amount     Float?
  amountUnit String?
  signalIds  Json     @default("[]") // string[] of the mirrored Signal ids
  ts         DateTime // the log instant — the client groups these into local days
  createdAt  DateTime @default(now())

  @@index([userId, ts])
}

// A workout scheduled to an athlete on a date. Blocks are a SNAPSHOT of the
// template at assignment time, so later edits to the template never change a
// workout already assigned. The athlete marks it complete (optionally linking
// the logged session).
model Assignment {
  id           String   @id @default(cuid())
  athlete      User     @relation("assignmentAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId    String
  assignedBy   User     @relation("assignmentCoach", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedById String
  templateId   String?
  name         String
  blocks       Json // SessionBlock[] snapshot
  date         DateTime
  status       String   @default("assigned") // assigned | completed | skipped
  sessionId    String? // the logged Session that fulfilled it
  createdAt    DateTime @default(now())

  @@index([athleteId])
  @@index([athleteId, date])
  @@index([assignedById])
}

// A per-day override the athlete sets on their enrolled plan's week rail: a day
// they SKIPPED, or POSTPONED to a later date. "done" and "missed" stay DERIVED
// (from logged sessions + the calendar) — only explicit intent is persisted here,
// so this table is small and never fights the reconciliation engine. `date` and
// `postponedTo` are the client's LOCAL date keys (yyyy-mm-dd) stored verbatim, so
// the server never has to reason about the athlete's timezone. One row per
// (user, plan, date); the engine (planSchedule) consumes them as its override map.
model PlanDayOverride {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  planId      String
  date        String // local date key yyyy-mm-dd
  status      String // "skipped" | "postponed"
  postponedTo String? // target local date key when postponed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, planId, date])
  @@index([userId, planId])
}

model CoachNote {
  id        String    @id @default(cuid())
  link      CoachLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId    String
  body      String
  private   Boolean   @default(false) // private notes the client never sees
  createdAt DateTime  @default(now())

  @@index([linkId])
}

model Session {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  startedAt    DateTime
  completedAt  DateTime?
  blocks       Json // exercises/sets/reps/load/rpe — matches the prototype block shape
  readiness    Int?
  // Private post-workout reflection (owner-only — NEVER serialised to coaches,
  // the Activity feed or social). `mood` is 1..4 (rough → strong, core MOODS);
  // `tags` are short slugs (core SUGGESTED_TAGS). All optional.
  note         String?
  mood         Int?
  tags         String[]  @default([])
  // "How did that feel?" — the post-workout self-report, asked once on the
  // Wrapped. `feel` is perceived effort (1..5, easy → all out) and `fatigue` is
  // how spent the athlete is after (1..5, fresh → wrecked). Effort × duration is
  // the session's internal training load (sRPE); see core/session-feel.ts. Kept
  // owner-only like the note above.
  feel         Int?
  fatigue      Int?
  // WHEN the athlete answered. Set server-side on every write of feel/fatigue.
  // The lag between completedAt and this is what makes two identical `fatigue`
  // values comparable: 4 an hour after training is an ordinary hard session, 4
  // ten hours later is a recovery problem. See core/feel-timing.ts. Null on
  // rows written before this column existed — the models degrade to the raw
  // report rather than inventing a lag.
  feelLoggedAt DateTime?
  // The SAME workout as the athlete's device recorded it (Apple Watch via
  // HealthKit today), attached by the summary's match flow: measured duration,
  // kcal, avg/max HR, distance, frozen at match time. Shape + sanitisation in
  // core/session-device.ts (sanitizeDeviceWorkout); owner-only like the note.
  device       Json?
  // Soft-archive: the athlete can hide a workout from History without losing it
  // (recoverable), or hard-delete it outright. Archived rows are excluded from
  // the default History list + all engines, but kept for the audit trail.
  archivedAt   DateTime?

  // The QUERYABLE projections of this row. `blocks` above stays the source of
  // truth — the document the athlete edits — and these are derived, disposable
  // and rebuildable from it (core/session-facts.ts, core/session-streams.ts).
  // Cascade-deleted with the session, so a deleted workout leaves nothing behind.
  sets    SessionSet[]
  streams SessionStream[]
  laps    SessionLap[]

  // History/engine reads are "where userId (+ archivedAt is null) order by
  // startedAt desc". A bare userId index made Postgres sort in memory and
  // couldn't serve the global `order by startedAt` admin paths.
  @@index([userId, startedAt])
  @@index([userId, archivedAt, startedAt])
  @@index([startedAt])
}

// ONE PERFORMED EFFORT — a strength SET, or a whole timed effort — as a row.
//
// `Session.blocks` is a Json document: the right shape for the thing the athlete
// edits, and the wrong one for every question asked across sessions or across
// athletes. A set inside a JSON column is not a value Postgres can see, so it
// cannot be indexed, grouped, or joined; "how many working sets of Back Squat
// above RPE 9 last month" had to load whole sessions into the lambda and walk
// them in TypeScript under a `take:` cap that silently truncates the answer.
// Every cross-athlete analytic in the app was that shape.
//
// This is the fact table that fixes it. It is a PROJECTION, written on every
// session write from core's `sessionSetFacts` — never edited directly, never
// read to render a workout, and safe to drop and rebuild. The engines' own
// helpers compute the derived columns (effective load, tonnage, e1RM, pace), so
// an aggregate here and a figure on a screen cannot drift.
//
// FULLY DENORMALISED ON PURPOSE. userId, performedAt and archived are copied
// onto every row so the questions this table exists for never join back to
// Session — a warehouse table that needs a join for its most common filter is
// not a warehouse table. The write path keeps them in step (an archive flips
// `archived` on the session's rows in the same call).
model SessionSet {
  id        String  @id @default(cuid())
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // Copied from the session so a date-ranged aggregate never joins.
  performedAt DateTime
  // Mirrors Session.archivedAt != null. Archived workouts stay out of every
  // analytic exactly as they stay out of History.
  archived    Boolean  @default(false)

  // Position within the document this row came from. (blockIndex, setIndex) is
  // unique per session and stable, so a reprojection can upsert rather than
  // churn ids. Timed efforts have no sets — theirs is always setIndex 0.
  blockIndex Int
  setIndex   Int

  kind       String // strength | cardio | conditioning
  exercise   String // the name as stored (already canonicalised on read)
  movement   String? // engine movement pattern — "hinge", "push-v", …
  muscles    String[] @default([]) // engine muscle groups (0–3)
  discipline String? // coarse cardio modality — "running", "swimming", …

  // ---- strength ----------------------------------------------------------
  role            String  @default("working") // working | warmup | cooldown
  drop            Boolean @default(false)
  reps            Int?
  loadKg          Float? // as entered, before the bodyweight modes
  // The bodyweight this row was resolved AGAINST (kg), when the lift's load
  // mode needed one. Kept because a later weigh-in makes old rows stale rather
  // than wrong — without the column nobody could tell which rows to reproject.
  bodyweightKg    Float?
  effectiveLoadKg Float? // what was actually moved per rep
  volumeKg        Float? // effectiveLoad × reps × implements
  e1rmKg          Float? // Epley, from this set alone
  rpe             Float?
  velocityMs      Float? // VBT mean concentric velocity
  peakVelocityMs  Float?
  romCm           Float?
  restSec         Int? // MEASURED rest before this set (never the prescription)

  // ---- timed efforts -----------------------------------------------------
  distanceKm   Float?
  durationSec  Int? // second-accurate where a recording supplied it
  paceSecPerKm Float?
  elevationM   Float?
  watts        Float?
  zone         Int?
  rounds       Int?

  // True when this row's figures came from a matched device recording rather
  // than from what the athlete typed — the provenance every analytic should be
  // able to weight or filter on.
  measured Boolean @default(false)

  createdAt DateTime @default(now())

  // One row per (session, block, set) — the natural key of the projection, and
  // what makes a rewrite idempotent.
  @@unique([sessionId, blockIndex, setIndex])
  // An athlete's own history, by date — the per-user analytics path.
  @@index([userId, performedAt])
  // One athlete's history of ONE lift: the progression/e1RM chart's query.
  @@index([userId, exercise, performedAt])
  // CROSS-ATHLETE, the ones that were impossible before: everybody's sets of a
  // lift, of a movement pattern, of a discipline, over a window.
  @@index([exercise, performedAt])
  @@index([movement, performedAt])
  @@index([discipline, performedAt])
  @@index([performedAt])
}

// A RECORDED SERIES — the second-by-second data underneath a workout summary.
//
// Session.device holds a DeviceWorkout: duration, distance, kcal, average and
// peak heart rate. That is a summary, and summary-level Apple Health data is a
// commodity every app can read. The shape underneath — where the heart rate
// went and when, the route, the power — is what a wearable company actually
// owns, and none of it was landing here. It also cannot be recovered later: a
// recording not read at match time is one the athlete must re-import by hand.
//
// ONE ROW PER (session, kind), holding parallel offsets/values arrays rather
// than a row per sample: an hour of 1 Hz heart rate is 3 600 samples, so a
// per-sample table is millions of rows per athlete-year and unaffordable to
// index at a million athletes. Postgres arrays keep it queryable (`unnest`)
// without that, and the aggregate columns below answer the common questions
// without touching the arrays at all. Shape, bounds and the 3 000-sample cap
// live in core/session-streams.ts.
model SessionStream {
  id        String  @id @default(cuid())
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  performedAt DateTime
  archived    Boolean  @default(false)

  // hr | power | cadence | speed | altitude | distance | route
  kind String
  // The unit is fixed by the kind (core STREAM_UNIT), stored so a reader never
  // has to know the table's conventions to plot it.
  unit String

  // Which connector produced it, and that provider's id for the recording — so
  // a re-import recognises what it already stored rather than duplicating it.
  provider String @default("apple")
  uuid     String

  // The instant `offsets` are measured from — the recording's start.
  startedAt DateTime
  // Seconds from startedAt, strictly increasing; values[i] belongs to
  // offsets[i]. Whole seconds, not timestamps: 3 000 ISO strings are 72 KB of
  // mostly-identical prefix, and the anchor only needs storing once.
  offsets   Int[]
  values    Float[]
  // Longitude, for `route` only — values holds the latitude of the same fix.
  valuesB   Float[]  @default([])

  // Lifted out of the arrays so "average power", "peak heart rate" and "how
  // long was it" are column reads. Null for `route`, where the mean of a set of
  // latitudes is a point in a field, not a fact about a run.
  sampleCount Int
  durationSec Int
  min         Float?
  max         Float?
  avg         Float?

  createdAt DateTime @default(now())

  // One series per kind per session — a re-import replaces rather than stacks.
  @@unique([sessionId, kind])
  @@index([userId, performedAt])
  @@index([kind, performedAt])
}

// A LAP — one delimited piece of a recording, and the row a personal record is
// actually looked up from.
//
// Four kinds (core LapKind): `lap` (the athlete pressed the button), `split` (a
// machine split at a round distance), `segment` (a leg of a multi-sport
// recording), and `best` — a DERIVED best effort, the fastest window inside the
// recording covering a catalog distance. Bests are stored rather than computed
// on read for one reason: "my fastest 5 km" must be an indexed lookup, not a
// scan over every stream the athlete has ever recorded.
//
// Laps get a row each where samples do not, because laps are tens per workout
// rather than thousands — the grain is affordable and the queries need it.
model SessionLap {
  id        String  @id @default(cuid())
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  performedAt DateTime
  archived    Boolean  @default(false)

  kind  String // lap | split | segment | best
  index Int // position within its kind, 0-based

  startOffsetSec Int // seconds from the recording's start
  durationSec    Float
  distanceKm     Float?
  avgHr          Int?
  maxHr          Int?
  avgWatts       Float?
  elevationM     Float?
  paceSecPerKm   Float?

  createdAt DateTime @default(now())

  @@unique([sessionId, kind, index])
  @@index([userId, performedAt])
  // "The athlete's fastest 5 km ever" and "everybody's fastest 5 km" — the two
  // questions the record ladder could not ask before the streams landed.
  @@index([userId, kind, distanceKm, durationSec])
  @@index([kind, distanceKm, durationSec])
}

// A workout logged BEFORE the athlete has an account (guest mode). The mobile
// client mirrors guest sessions here (best-effort, no auth) so an admin can see
// real product usage from people who haven't signed up yet. There is no userId —
// only an opaque per-device id. When the guest signs up, their on-device history
// is flushed into real Session rows; these anonymous rows are kept as-is.
model AnonSession {
  id        String   @id @default(cuid())
  deviceId  String? // opaque per-install id (not PII) — to group a device's logs
  platform  String? // "ios" | "android" | "web"
  title     String
  startedAt DateTime
  blocks    Json // same block shape as Session
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([createdAt])
}

model Macrocycle {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // The GOAL_TREE id (e.g. "hybrid", "power"), NOT the display name — see
  // packages/core/src/goal-id.ts. It held the display name until Aug 2026,
  // which meant a rename or a translation silently re-routed the periodization
  // model and split the column into two values for one goal. Every write path
  // normalises through `goalIdToStore`, so an older client sending a name still
  // lands an id. Rows written before that hold names and are read through
  // `goalLabel` (reference/sql-macrocycle-goal-id.sql normalises them when the
  // operator chooses to). A COACH-AUTHORED goal is free text and stays verbatim.
  goal      String
  // The enrolled NAMED plan id (e.g. "bb-fb4"), when the athlete picked a real
  // plan from the library — drives "Your plan today". Null for a goal-only
  // enrollment (engine-prescribed). Mirrors the plan library's GoalPlan.id.
  planId    String?
  eventDate DateTime?
  blocks    Json // meso/micro structure from buildMacrocycle()
  startedAt DateTime  @default(now())

  @@index([userId])
}

model Biometric {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime
  hrv       Float?
  restingHr Float?
  sleepH    Float?
  source    String // "apple" | "whoop" | ...

  // Read as "where userId order by date desc".
  @@index([userId, date])
}

// The Athlete Twin's universal time-series. Every measurement — recovery, GPS
// load, force-plate, blood, composition — lands here as ONE shape from any
// source, so the engines read a single stream (see @hybrid/core signal
// ontology). Generalizes Biometric; same own-rows RLS as Session/Biometric.
model Signal {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  kind   String // "hrv" | "restingHr" | "sleep" | "highSpeedRunning" | ...
  value  Float
  unit   String
  source String // "apple" | "whoop" | "garmin" | "catapult" | "manual" | ...
  ts     DateTime

  // de-dupe overlapping wearable syncs (same reading from the same source)
  @@unique([userId, kind, ts, source])
  @@index([userId, kind, ts])
}

// A return-to-play protocol instance for an athlete + tissue. The gated stage
// progression lives in @hybrid/core (rtp.ts); this stores state + audit.
model RtpProtocol {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tissue     String
  injuryDate DateTime
  stage      String   @default("acute")
  completed  Json // string[] of gate keys met in the current stage
  status     String   @default("active") // "active" | "cleared" | "abandoned"
  audit      Json     @default("[]") // append-only: who attested gates / advanced / overrode
  createdAt  DateTime @default(now())

  @@index([userId])
}

// A labeled risk outcome — the training signal for the injury calibration.
// Captured when an injury occurs (RTP opened) or fed in from medical records.
model RiskOutcome {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  tissue  String?
  score   Float // the heuristic risk score at the time
  injured Boolean
  ts      DateTime @default(now())

  @@index([userId])
}

// The active fitted model coefficients (e.g. injury calibration). Latest row
// per `key` is live; computeInjuryRisk applies it. Refit via the data network.
model ModelFit {
  id        String   @id @default(cuid())
  key       String // "injury-calibration"
  intercept Float
  slope     Float
  n         Int
  version   String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A connected wearable/sensor account. Tokens let the server sync provider
// data into the Signal ontology. Own-rows RLS (see reference SQL). Tokens
// should be encrypted at rest in production.
model Connection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  provider     String // "whoop" | "oura" | "garmin" | "apple" | ...
  status       String    @default("active") // "active" | "revoked" | "error"
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

// Pre-built plan library (admin-managed).
model Plan {
  id     String @id @default(cuid())
  goalId String
  name   String
  level  String
  detail Json // the PLAN_DETAIL shape from the prototype
}

// Admin-authored broadcast message surfaced in-app (the first CMS content type).
// Authored + published from the admin console; read by clients via the API.
// Mutations are server-only (admin-gated + audited); RLS lets any signed-in user
// read only PUBLISHED rows (reference/sql-announcement.sql), defense-in-depth.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String // plain text / light markdown
  level       String    @default("info") // "info" | "success" | "warning"
  audience    String    @default("all") // "all" | "coaches" | "clients"
  status      String    @default("draft") // "draft" | "published" | "archived"
  pinned      Boolean   @default(false) // show as a dismissible banner
  publishAt   DateTime? // scheduled go-live; null = live the moment it's published
  expiresAt   DateTime? // auto-hide after this instant; null = no expiry
  authorId    String // the admin who created it (no relation — survives user delete)
  authorEmail String // denormalized for the audit trail / display
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishAt])
}

// Admin-managed exercise library (CMS content type #2). A SUPERSET of the core
// Movement shape: the engine-critical fields (pattern/muscles/baseLoad/system)
// PLUS authored content (cues, equipment, demo video, aliases). The 9 built-in
// movements stay in @hybrid/core (engines stay pure); this table holds CUSTOM
// exercises + overrides, merged over the built-ins by name at read time
// (mergeMovements). Mutations server-only + audited; RLS lets signed-in users
// read only PUBLISHED rows (reference/sql-exercise.sql).
model Exercise {
  id   String @id @default(cuid())
  slug String @unique // stable id, e.g. "back-squat"
  name String @unique // display name = the engine key, e.g. "Back Squat"

  // engine-critical (mirror core Movement; validated against the core enums)
  pattern  String // squat | hinge | push | pull | lunge | carry | core | cond
  muscles  String[] // MuscleGroup[] (quads/glutes/posterior/back/chest/shoulders/triceps)
  baseLoad Float? // kg working baseline; null for conditioning
  system   String? // anaerobic | threshold | aerobic | null

  // CMS content
  kind        String   @default("strength") // strength | conditioning
  category    String? // library grouping, e.g. "Lower", "Olympic"
  equipment   String[] // ["barbell","rack"]
  aliases     String[] // alternate names → resolve renames + logged free-text
  description String?
  cues        String[] // coaching cues
  videoUrl    String? // demo clip (the blocked video library plugs in here)
  thumbUrl    String?

  // lifecycle / provenance
  status      String   @default("published") // draft | published | archived
  source      String   @default("custom") // builtin | custom
  authorId    String?
  authorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// Admin-managed media library (CMS content #3): the shared asset catalog
// (exercise demo clips, announcement imagery, …). The bytes live in a PUBLIC
// Supabase Storage bucket "media" (admin-only writes via is_admin() RLS); this
// table is the catalog — title/alt/tags/lifecycle + the stable public URL other
// content (an Exercise's videoUrl) points at. Mutations server-only + audited;
// RLS lets signed-in users read only PUBLISHED rows (reference/sql-media-library.sql).
model MediaAsset {
  id          String   @id @default(cuid())
  path        String   @unique // object path within the media bucket
  url         String // stable public URL (the bucket is public-read)
  title       String
  alt         String? // caption / accessibility text
  kind        String   @default("image") // image | video | other
  contentType String?
  sizeBytes   Int?
  width       Int?
  height      Int?
  tags        String[] // search/filtering
  status      String   @default("published") // draft | published | archived
  authorId    String?
  authorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([kind])
}

// Admin-authored localization override (CMS content #4). A SPARSE layer over the
// shipped TRANSLATIONS in @hybrid/core: one row per (lang, key) an admin edited
// or added. The clients load these and layer them over the baseline via
// makeTWithOverrides, so a non-engineer can fix copy or fill a missing PL/DE
// string without a deploy. Mutations server-only + audited; RLS lets signed-in
// users read all rows (reference/sql-translation.sql).
model Translation {
  id             String   @id @default(cuid())
  lang           String // en | pl | de
  key            String // dotted key, e.g. "nav.today"
  value          String
  updatedById    String?
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([lang, key])
  @@index([lang])
}

// Admin-authored feature-flag override (CMS content #5: runtime config). A
// SPARSE layer over the FEATURE_FLAGS registry in @hybrid/core — one row per flag
// an admin toggled / scoped / configured. The clients read the evaluated flags
// from /api/flags; code gates on them. Mutations server-only + audited; RLS lets
// signed-in users read all rows (reference/sql-feature-flags.sql).
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique // matches a FEATURE_FLAGS registry key
  enabled        Boolean  @default(true)
  audience       String   @default("all") // all | coaches | clients | admins
  value          Json? // optional config payload
  updatedById    String?
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled])
}

// Per-user onboarding state — its OWN table (not columns on User) so the
// hot-path user lookup never depends on it: every read is soft-guarded, so the
// app runs fine before this migration is applied. `onboardedAt` is the
// server-side source of truth for "has this user finished/skipped onboarding?"
// — the clients gate the questionnaire on it so it reliably appears once and
// survives device changes + the email-confirm round-trip (the old localStorage
// flag did not). `answers` stores the raw answer map (keyed by question key),
// including any custom admin-added questions. reference/sql-onboarding.sql.
model OnboardingState {
  userId      String   @id
  onboardedAt DateTime @default(now())
  answers     Json?
  updatedAt   DateTime @default(now()) @updatedAt
}

// One admin-editable onboarding question. The questionnaire is data, not
// hard-coded UI: admins reword / reorder / add / remove / enable-disable from
// the web admin. The five built-ins (persona, goal, experience, days, equipment)
// live as defaults in @hybrid/core (DEFAULT_ONBOARDING_QUESTIONS) so onboarding
// works with an empty DB; rows here override/extend them. `engineKey` ties an
// answer to a recommendation-engine field; custom questions leave it null and
// are stored on the user profile without affecting plan matching. `system` marks
// a built-in (can't be deleted; key/kind/engineKey locked in the editor).
// Mutations are server-only (ADMIN-gated + audited); signed-in users read the
// enabled rows via /api/onboarding/questions. reference/sql-onboarding.sql.
model OnboardingQuestion {
  id           String   @id @default(cuid())
  key          String   @unique // answer key (stable; e.g. "goal", "how-heard")
  kind         String   @default("single") // persona | goal | single | multi | number | text
  title        String
  subtitle     String?
  engineKey    String? // persona | goal | experience | daysPerWeek | equipment | null
  choices      Json? // [{ value, label, blurb? }] for single/multi
  min          Int?
  max          Int?
  step         Int?
  defaultValue String?
  required     Boolean  @default(false)
  enabled      Boolean  @default(true)
  system       Boolean  @default(false)
  // WHICH INTAKE ASKS THIS — [] or null means both. The persona question forks
  // the wizard (packages/core/src/onboarding.ts), so a question can belong to
  // the goal intake, the tracker intake, or both. A BUILT-IN's scope is locked
  // to the code default and this column is ignored for it: persona scope is
  // structural rather than copy, and a stored row that could widen it would
  // silently un-fork the wizard. Custom questions own theirs.
  // reference/sql-onboarding-personas.sql.
  personas     String[] @default([])
  order        Int      @default(0)
  authorId     String?
  authorEmail  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled, order])
}

// The editable definition of one AI executive agent (CEO/CFO/CMO/COO + custom).
// The KNOWN role presets live in @hybrid/core (so the org has working defaults
// with an empty DB); this table stores the admin's edits — mandate, KPIs,
// responsibilities, guardrails, model/effort, status. buildSystemPrompt() in
// core turns a row into the live prompt. Mutations are server-only (ADMIN-gated
// + audited); reads are admin-only via the API. JSON columns are arrays.
model AgentConfig {
  id                   String   @id @default(cuid())
  role                 String // "CEO" | "CFO" | … | custom label
  name                 String
  status               String   @default("draft") // draft | active | paused
  model                String   @default("claude-opus-4-8")
  effort               String   @default("high") // low | medium | high | xhigh | max
  authority            String   @default("functional") // executive | functional | advisor
  reportsTo            String? // supervisor role/name; null = reports to the admin
  mandate              String
  responsibilities     Json     @default("[]") // string[]
  kpis                 Json     @default("[]") // { metric, target }[]
  guardrails           Json     @default("[]") // string[]
  escalationThreshold  String   @default("")
  tone                 String   @default("")
  collaborators        Json     @default("[]") // string[]
  tools                Json     @default("[]") // string[]
  runtime              String   @default("messages") // messages | managed
  managedAgentId       String? // Claude Managed Agents agent id (created lazily, reused)
  memoryStoreId        String? // durable memory store id (created lazily, reused)
  approvalThresholdUsd Float    @default(0) // require 2nd-operator approval when est. run cost ≥ this (0 = off)
  budgetUsd7d          Float    @default(0) // auto-pause when trailing-7d spend ≥ this (0 = off)
  updatedById          String?
  updatedByEmail       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

// One execution of an agent — the run history / transcript. Written server-side
// by the run + stream routes (best-effort; never blocks the run). Read is
// admin-only via the API. Denormalized agent role/name so it survives edits.
model AgentRun {
  id           String   @id @default(cuid())
  agentId      String
  agentRole    String
  agentName    String
  task         String
  output       String // final synthesized output
  steps        Json     @default("[]") // delegation trace: { agent, role, task, output }[]
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  status       String   @default("ok") // ok | error
  runtime      String   @default("messages") // messages | managed
  ranById      String?
  ranByEmail   String?
  createdAt    DateTime @default(now())

  @@index([agentId, createdAt])
  // Global admin views sort runs by recency without an agentId filter, which the
  // composite above can't serve.
  @@index([createdAt])
}

// A standing task that runs an agent on a cadence. The cron route (/api/cron/
// agents) picks up enabled schedules whose nextRunAt is due, runs the agent, and
// rolls nextRunAt forward. Server-only writes (ADMIN-gated API); deny-by-default.
model AgentSchedule {
  id             String    @id @default(cuid())
  agentId        String
  task           String
  cadence        String    @default("daily") // hourly | daily | weekly
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([agentId])
}

// A recorded numeric actual for one of an agent's KPIs, over time — the "actual"
// side of the target-vs-actual scorecard. Logged by an admin (or, later, an
// agent). Server-only writes; deny-by-default RLS.
model AgentKpiMeasurement {
  id              String   @id @default(cuid())
  agentId         String
  metric          String // matches a Kpi.metric on the agent
  value           Float
  note            String?
  recordedById    String?
  recordedByEmail String?
  createdAt       DateTime @default(now())

  @@index([agentId, metric, createdAt])
}

// A run held for a second operator's approval (two-person control). Created when
// an agent's estimated run cost crosses its approvalThresholdUsd; a DIFFERENT
// operator approves (which executes it) or denies. Server-only; deny-by-default.
model AgentApproval {
  id               String    @id @default(cuid())
  agentId          String
  agentName        String
  task             String
  estimateUsd      Float     @default(0)
  runtime          String    @default("messages")
  status           String    @default("pending") // pending | approved | denied
  requestedById    String?
  requestedByEmail String?
  decidedById      String?
  decidedByEmail   String?
  runId            String? // the AgentRun produced once approved + executed
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?

  @@index([status, createdAt])
}

// A persistent, dismissible notification for the Agent HQ inbox (e.g. a failed
// run). Written best-effort when the event happens; marked read by the admin.
// Server-only; deny-by-default RLS.
model AgentNotification {
  id        String   @id @default(cuid())
  kind      String // run_failed | …
  agentId   String?
  agentName String?
  title     String
  body      String?
  severity  String   @default("warning") // info | warning | error
  read      Boolean  @default(false)
  refId     String? // related entity (e.g. AgentRun id)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// A user-submitted content report — the second feeder of the admin moderation
// queue (alongside discoverable talent profiles awaiting approval). Denormalized
// (no FK relations, like AdminAudit) so it survives a reporter/target delete.
// Filed by any signed-in user; resolved by a moderator. Server-only reads.
model Report {
  id              String    @id @default(cuid())
  reporterId      String
  reporterEmail   String
  targetType      String // "talentProfile" | …
  targetId        String
  reason          String // inappropriate | fake | spam | other
  detail          String?
  status          String    @default("open") // open | resolved | dismissed
  resolution      String? // moderator note
  resolvedById    String?
  resolvedByEmail String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

// Append-only record of every privileged action taken in the admin panel.
// Written server-side by the /api/admin/* routes (never by a client). Read is
// admin-only. This is the institutional accountability layer: who did what, to
// whom, when, and what changed. Never deleted or mutated.
model AdminAudit {
  id         String   @id @default(cuid())
  // Nullable + SetNull so the audit row OUTLIVES a deleted actor (the trail must
  // survive an account deletion); actorEmail below keeps it human-readable.
  actor      User?    @relation("adminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorEmail String // denormalized so the log survives a user rename/delete
  action     String // dotted verb, e.g. "user.role.update", "user.view"
  targetType String? // "user" | "org" | "coachLink" | ...
  targetId   String? // the affected entity's id
  summary    String? // human-readable one-liner
  metadata   Json? // structured before/after + reason
  ip         String? // best-effort request IP
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Email — transactional + marketing + lifecycle automation.
//
// One provider abstraction (Resend) sends everything; these tables are the
// HYBRID-side record + the campaign/automation control plane. All mutations are
// server-only (admin-gated + audited, or the cron worker). Every send lands a
// row in EmailMessage so deliverability + history are auditable. See
// reference/sql-email.sql. All queries are soft-guarded so the app runs before
// the migration is applied (the feature just no-ops / reports "unavailable").
// ---------------------------------------------------------------------------

// The deliverability ledger — one row per attempted send (campaign, sequence
// step, or transactional). The single source of truth for "did we email them".
model EmailMessage {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  subject    String
  kind       String    @default("transactional") // transactional | verification
  status     String    @default("sent") // sent | failed | bounced
  providerId String? // Resend message id
  error      String?
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([userId])
  @@index([kind, createdAt])
}

// Idempotency ledger for inbound provider webhooks (Stripe). The event id is the
// PK, so re-processing a redelivered event is a no-op (Stripe retries on any
// non-2xx and can deliver the same event more than once by design).
model ProcessedWebhookEvent {
  id          String   @id // the provider's event id (e.g. Stripe evt_...)
  provider    String   @default("stripe")
  type        String
  processedAt DateTime @default(now())
}
