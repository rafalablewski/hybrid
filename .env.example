# HYBRID — environment variables.
# Copy this to apps/web/.env  (NOT repo root, NOT .env.local):
#   - Prisma migrate runs from apps/web and reads .env (it ignores .env.local)
#   - Next.js (apps/web) reads .env too, so one file covers both
# Also set the same vars in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. NEXT_PUBLIC_* are exposed to the browser.

# --- Supabase (Sprint 1) ---------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only. Never exposed to the browser; used by trusted server code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database / Prisma (Sprint 1) ------------------------------------------
# Project → Settings → Database → Connection string.
# DATABASE_URL = pooled (PgBouncer, port 6543, add ?pgbouncer=true) for the app.
# DIRECT_URL   = direct (port 5432) for prisma migrate.
DATABASE_URL="postgresql://postgres.hgufkvwccodogieqygyy:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.hgufkvwccodogieqygyy:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- AI coach (later sprint) -----------------------------------------------
# Server-side only — never call Anthropic from a client.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Billing: the paid "Full" upgrade --------------------------------------
# The whole flow is built; it only needs these credentials to go live.
# Public app origin used for Stripe success/cancel + portal return URLs.
NEXT_PUBLIC_APP_URL="https://YOUR-DOMAIN.vercel.app"
# Stripe (web checkout). Dashboard → Developers → API keys / Products / Webhooks.
STRIPE_SECRET_KEY="sk_test_..."                 # server-only
STRIPE_PRICE_FULL="price_..."                   # the Full subscription Price id
STRIPE_WEBHOOK_SECRET="whsec_..."               # from the webhook endpoint signing secret
# Point a Stripe webhook at: POST /api/billing/webhook
# (events: checkout.session.completed, customer.subscription.*)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..." # if/when doing client-side Stripe.js
# Apple In-App Purchase (mobile) — App Store Server API (StoreKit 2).
# App Store Connect → Users and Access → Integrations → App Store Connect API:
#   create an In-App-Purchase key, download the .p8 ONCE, note the Key ID + Issuer ID.
# The .p8 is a SECRET — paste its contents here (\n-escaped), never commit the file.
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APPLE_IAP_KEY_ID="ZRWGCS2PUS"                    # matches the AuthKey_<KEYID>.p8 filename
APPLE_IAP_ISSUER_ID="00000000-0000-0000-0000-000000000000"  # App Store Connect API Issuer ID (UUID)
APPLE_IAP_BUNDLE_ID="com.hybrid.app"             # the app's bundle id
APPLE_IAP_PRODUCT_FULL="com.hybrid.full.monthly" # the auto-renewable product id that grants Full
# The mobile app reads the same product id from EXPO_PUBLIC_IAP_PRODUCT_FULL
# (apps/mobile/.env) — keep the two values identical and matching the App Store
# Connect product. Defaults to com.hybrid.full.monthly if unset.
APPLE_IAP_ENV="Sandbox"                          # "Sandbox" (testing) | "Production"
APPLE_IAP_APP_APPLE_ID=""                        # numeric App Apple ID — REQUIRED when ENV=Production
# APPLE_ROOT_CERTS_DIR — OPTIONAL. Defaults to apps/web/lib/apple-root-certs;
# only set this to point at a different dir of Apple root CA .cer files.
# APPLE_ROOT_CERTS_DIR="lib/apple-root-certs"
APPLE_IAP_ONLINE_CHECKS="true"                   # OCSP revocation checks; "false" to disable

# --- Email: Resend (TRANSACTIONAL only) ------------------------------------
# Account verification + coach invites. Until these are set, every send degrades
# to a "not configured" no-op, recorded as such in the EmailMessage ledger.
# The marketing/lifecycle platform (campaigns, sequences, suppression) was cut
# in the 2026-08 strategy review — buy that when there is an audience for it.
# Resend dashboard → API Keys: https://resend.com/api-keys
RESEND_API_KEY="re_..."                          # server-only
# The verified sending identity (must be a domain you've verified in Resend).
EMAIL_FROM="HYBRID <hello@yourdomain.com>"
# Optional override for links in transactional mail; defaults to NEXT_PUBLIC_APP_URL.
# EMAIL_PUBLIC_URL="https://yourdomain.com"

# --- Push notifications: APNs (the retention bell) -------------------------
# Three notifications ship (packages/core/src/push.ts): the morning readiness
# nudge, a coach assignment, and a co-sign request on a claimed record. Sent
# STRAIGHT TO APPLE — no Expo push service, no EAS project (apps/web/lib/apns.ts
# explains why). Until these are set every send is a recorded no-op, so the app
# registers device tokens and nothing arrives.
#
# App Store Connect → Users and Access → Integrations → Keys: create an "Apple
# Push Notifications service (APNs)" key with access to this app, download the
# .p8 ONCE, note the Key ID. The Team ID is on the membership page.
# The .p8 is a SECRET — paste its contents here (\n-escaped), never commit it.
APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APNS_KEY_ID=""                                   # matches the AuthKey_<KEYID>.p8 filename
APNS_TEAM_ID=""                                  # Apple Developer Team ID (10 chars)
# OPTIONAL. Defaults to com.hybriddomain.xyz — the app's bundle id, which is the
# APNs topic. Only set it if the bundle id changes.
# APNS_BUNDLE_ID="com.hybriddomain.xyz"
# OPTIONAL. A device token is only valid on the host that issued it: a
# TestFlight/App Store build gets a PRODUCTION token, a development-signed build
# a SANDBOX one. Unset is the right answer — the sender tries production, falls
# back to sandbox once, and remembers per device. Set it only to PIN one host.
# APNS_ENVIRONMENT="production"

# --- Cron (scheduled workers) ----------------------------------------------
# Bearer token for /api/cron/* . Vercel Cron sends it for the daily agent jobs
# AND the hourly morning-nudge job — .github/workflows/push-nudge.yml, which
# also needs CRON_SECRET as a repo SECRET and the origin as a repo VARIABLE
# (SITE_URL). It runs hourly because 07:00 is the ATHLETE's 07:00, not the
# server's, and it lives in Actions rather than vercel.json because an hourly
# Vercel cron exceeds the Hobby plan's once-a-day limit and fails the deploy.
CRON_SECRET="a-long-random-string"

# --- SMS: Twilio (coach invite by text — NOT built yet) --------------------
# Placeholder so the SMS path isn't forgotten (capability: coach-invite-sms).
# When wired, POST /api/coach/invite would text the invite link when a phone is
# given. Twilio console → Account Info. Carries a per-message cost.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM_NUMBER="+1..."          # a Twilio sending number

# --- Rate limiting: shared store (Upstash / Vercel KV) ---------------------
# The per-IP rate limiter (apps/web/lib/guard.ts) enforces fleet-wide ONLY when
# a shared store is configured; without one it falls back to a per-instance
# in-memory map (best-effort, effectively unlimited under multi-instance load).
# Set EITHER the Vercel KV vars OR the Upstash vars (the REST API is identical):
#   Vercel: Storage → KV → create → copy the REST URL + token.
#   Upstash: console.upstash.com → create a Redis DB → REST API section.
# KV_REST_API_URL="https://....upstash.io"
# KV_REST_API_TOKEN="..."
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
