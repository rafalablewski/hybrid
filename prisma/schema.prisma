// HYBRID data model — Sprint 1.
// Postgres on Supabase. The permission model lives HERE (roles + CoachLink),
// not in the UI. Row-level security is enforced in Supabase / API middleware:
//   - a user reads/writes Session, Macrocycle, Biometric only WHERE userId = auth.uid()
//   - a coach reads a client's data only via an ACTIVE CoachLink
//   - private CoachNotes are never returned to the client
//   - admins read aggregates only — never another user's raw private rows

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for the app; direct connection for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum LinkStatus {
  PENDING
  ACTIVE
  ENDED
}

model User {
  id        String   @id @default(cuid())
  // Mirrors the Supabase auth.users id so RLS can match auth.uid().
  authId    String?  @unique
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT) // a user can be COACH and CLIENT at once
  language  String   @default("en")
  createdAt DateTime @default(now())

  sessions      Session[]
  macrocycles   Macrocycle[]
  biometrics    Biometric[]
  signals       Signal[]
  connections   Connection[]
  memberships   Membership[]
  rtpProtocols  RtpProtocol[]
  videos        VideoAnalysis[]
  events        Event[]
  talentProfile TalentProfile?
  riskOutcomes  RiskOutcome[]
  checkins      Checkin[]
  templates       WorkoutTemplate[]
  assignments     Assignment[]     @relation("assignmentAthlete")
  assignmentsMade Assignment[]     @relation("assignmentCoach")
  coachLinks    CoachLink[]     @relation("asClient")
  clientLinks   CoachLink[]     @relation("asCoach")
  adminAudits   AdminAudit[]    @relation("adminAuditActor")
}

// The mutual-consent coach↔client relationship. Authorization is by THIS,
// not by role label alone.
model CoachLink {
  id        String      @id @default(cuid())
  coach     User        @relation("asCoach", fields: [coachId], references: [id])
  coachId   String
  client    User        @relation("asClient", fields: [clientId], references: [id])
  clientId  String
  status    LinkStatus  @default(PENDING)
  tags      String[]    @default([]) // coach-authored labels for roster segmentation
  createdAt DateTime    @default(now())
  notes     CoachNote[]

  @@unique([coachId, clientId])
  @@index([clientId])
  @@index([coachId])
}

// The weekly check-in — the online-coaching heartbeat. The client submits
// structured self-report + a note; the coach reads and replies. Authored by the
// client (userId); a coach reads/replies via an ACTIVE CoachLink.
model Checkin {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  weekOf       DateTime // the week the check-in covers
  bodyMassKg   Float?
  energy       Int? // 1–5 self-report
  sleep        Int? // 1–5
  soreness     Int? // 1–5 (5 = very sore)
  mood         Int? // 1–5
  adherencePct Int? // self-reported plan adherence 0–100
  note         String? // client free text
  coachReply   String? // coach response
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// A reusable workout the coach (or athlete) builds once and assigns many times.
model WorkoutTemplate {
  id          String   @id @default(cuid())
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     String
  name        String
  description String?
  blocks      Json // SessionBlock[]
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// A workout scheduled to an athlete on a date. Blocks are a SNAPSHOT of the
// template at assignment time, so later edits to the template never change a
// workout already assigned. The athlete marks it complete (optionally linking
// the logged session).
model Assignment {
  id           String   @id @default(cuid())
  athlete      User     @relation("assignmentAthlete", fields: [athleteId], references: [id])
  athleteId    String
  assignedBy   User     @relation("assignmentCoach", fields: [assignedById], references: [id])
  assignedById String
  templateId   String?
  name         String
  blocks       Json // SessionBlock[] snapshot
  date         DateTime
  status       String   @default("assigned") // assigned | completed | skipped
  sessionId    String? // the logged Session that fulfilled it
  createdAt    DateTime @default(now())

  @@index([athleteId])
  @@index([assignedById])
}

model CoachNote {
  id        String    @id @default(cuid())
  link      CoachLink @relation(fields: [linkId], references: [id])
  linkId    String
  body      String
  private   Boolean   @default(false) // private notes the client never sees
  createdAt DateTime  @default(now())

  @@index([linkId])
}

model Session {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  title       String
  startedAt   DateTime
  completedAt DateTime?
  blocks      Json // exercises/sets/reps/load/rpe — matches the prototype block shape
  readiness   Int?

  @@index([userId])
}

model Macrocycle {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  goal      String
  eventDate DateTime?
  blocks    Json // meso/micro structure from buildMacrocycle()
  startedAt DateTime  @default(now())

  @@index([userId])
}

model Biometric {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime
  hrv       Float?
  restingHr Float?
  sleepH    Float?
  source    String // "apple" | "whoop" | ...

  @@index([userId])
}

// The Athlete Twin's universal time-series. Every measurement — recovery, GPS
// load, force-plate, blood, composition — lands here as ONE shape from any
// source, so the engines read a single stream (see @hybrid/core signal
// ontology). Generalizes Biometric; same own-rows RLS as Session/Biometric.
model Signal {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id])
  userId String
  kind   String // "hrv" | "restingHr" | "sleep" | "highSpeedRunning" | ...
  value  Float
  unit   String
  source String // "apple" | "whoop" | "garmin" | "catapult" | "manual" | ...
  ts     DateTime

  // de-dupe overlapping wearable syncs (same reading from the same source)
  @@unique([userId, kind, ts, source])
  @@index([userId, kind, ts])
}

// ---- Org Graph (Team Operating System) ----------------------------------
// A club/federation as one governed org: a team hierarchy + staff with roles.
// Access is scoped by role + data sensitivity in @hybrid/core (org.ts) and
// enforced in the API; org membership gates org-level reads in RLS.
model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  teams       Team[]
  memberships Membership[]
}

model Team {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  parent    Team?        @relation("TeamTree", fields: [parentId], references: [id])
  parentId  String?
  children  Team[]       @relation("TeamTree")
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([parentId])
}

model Membership {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  role      String // OrgRole: OWNER | DIRECTOR | COACH | MEDICAL | ANALYST | ATHLETE
  teamId    String? // optional: scope this member to a team subtree
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// A return-to-play protocol instance for an athlete + tissue. The gated stage
// progression lives in @hybrid/core (rtp.ts); this stores state + audit.
model RtpProtocol {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  tissue     String
  injuryDate DateTime
  stage      String   @default("acute")
  completed  Json // string[] of gate keys met in the current stage
  status     String   @default("active") // "active" | "cleared" | "abandoned"
  audit      Json     @default("[]") // append-only: who attested gates / advanced / overrode
  createdAt  DateTime @default(now())

  @@index([userId])
}

// A markerless motion-analysis result (pose capture is client/native; this
// stores the metrics from @hybrid/core video.ts). Derived asymmetry also lands
// in the Signal ontology.
model VideoAnalysis {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  movement  String
  metrics   Json // MotionAnalysis shape
  createdAt DateTime @default(now())

  @@index([userId])
}

// A target competition. The peaking optimizer (peaking.ts) back-solves the
// plan to land the athlete's best day on this date.
model Event {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  name      String
  sport     String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// An athlete's talent profile + benchmark inputs. Percentiles are computed in
// @hybrid/core (benchmarks.ts); visibility gates discovery (the talent market).
model TalentProfile {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  sport      String
  sex        String // "M" | "F"
  age        Int
  metrics    Json // { relStrength?, vo2?, durability?, hpi? }
  visibility String   @default("private") // "private" | "discoverable"
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([visibility])
}

// A labeled risk outcome — the training signal for the injury calibration.
// Captured when an injury occurs (RTP opened) or fed in from medical records.
model RiskOutcome {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  tissue  String?
  score   Float // the heuristic risk score at the time
  injured Boolean
  ts      DateTime @default(now())

  @@index([userId])
}

// The active fitted model coefficients (e.g. injury calibration). Latest row
// per `key` is live; computeInjuryRisk applies it. Refit via the data network.
model ModelFit {
  id        String   @id @default(cuid())
  key       String // "injury-calibration"
  intercept Float
  slope     Float
  n         Int
  version   String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A pending invitation to join an org by email, for people who don't have an
// account yet. Claimed automatically on first sign-in (email match).
model OrgInvite {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  role      String
  teamId    String?
  status    String   @default("pending") // "pending" | "accepted" | "revoked"
  createdAt DateTime @default(now())

  @@unique([orgId, email])
  @@index([email])
}

// A connected wearable/sensor account. Tokens let the server sync provider
// data into the Signal ontology. Own-rows RLS (see reference SQL). Tokens
// should be encrypted at rest in production.
model Connection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  provider     String // "whoop" | "oura" | "garmin" | "apple" | ...
  status       String    @default("active") // "active" | "revoked" | "error"
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

// Pre-built plan library (admin-managed).
model Plan {
  id     String @id @default(cuid())
  goalId String
  name   String
  level  String
  detail Json // the PLAN_DETAIL shape from the prototype
}

// Admin-authored broadcast message surfaced in-app (the first CMS content type).
// Authored + published from the admin console; read by clients via the API.
// Mutations are server-only (admin-gated + audited); RLS lets any signed-in user
// read only PUBLISHED rows (reference/sql-announcement.sql), defense-in-depth.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String // plain text / light markdown
  level       String    @default("info") // "info" | "success" | "warning"
  audience    String    @default("all") // "all" | "coaches" | "clients"
  status      String    @default("draft") // "draft" | "published" | "archived"
  pinned      Boolean   @default(false) // show as a dismissible banner
  publishAt   DateTime? // scheduled go-live; null = live the moment it's published
  expiresAt   DateTime? // auto-hide after this instant; null = no expiry
  authorId    String // the admin who created it (no relation — survives user delete)
  authorEmail String // denormalized for the audit trail / display
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishAt])
}

// Admin-managed exercise library (CMS content type #2). A SUPERSET of the core
// Movement shape: the engine-critical fields (pattern/muscles/baseLoad/system)
// PLUS authored content (cues, equipment, demo video, aliases). The 9 built-in
// movements stay in @hybrid/core (engines stay pure); this table holds CUSTOM
// exercises + overrides, merged over the built-ins by name at read time
// (mergeMovements). Mutations server-only + audited; RLS lets signed-in users
// read only PUBLISHED rows (reference/sql-exercise.sql).
model Exercise {
  id      String @id @default(cuid())
  slug    String @unique // stable id, e.g. "back-squat"
  name    String @unique // display name = the engine key, e.g. "Back Squat"

  // engine-critical (mirror core Movement; validated against the core enums)
  pattern  String // squat | hinge | push | pull | lunge | carry | core | cond
  muscles  String[] // MuscleGroup[] (quads/glutes/posterior/back/chest/shoulders/triceps)
  baseLoad Float? // kg working baseline; null for conditioning
  system   String? // anaerobic | threshold | aerobic | null

  // CMS content
  kind        String   @default("strength") // strength | conditioning
  category    String? // library grouping, e.g. "Lower", "Olympic"
  equipment   String[] // ["barbell","rack"]
  aliases     String[] // alternate names → resolve renames + logged free-text
  description String?
  cues        String[] // coaching cues
  videoUrl    String? // demo clip (the blocked video library plugs in here)
  thumbUrl    String?

  // lifecycle / provenance
  status      String   @default("published") // draft | published | archived
  source      String   @default("custom") // builtin | custom
  authorId    String?
  authorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// Append-only record of every privileged action taken in the admin panel.
// Written server-side by the /api/admin/* routes (never by a client). Read is
// admin-only. This is the institutional accountability layer: who did what, to
// whom, when, and what changed. Never deleted or mutated.
model AdminAudit {
  id         String   @id @default(cuid())
  actor      User     @relation("adminAuditActor", fields: [actorId], references: [id])
  actorId    String
  actorEmail String // denormalized so the log survives a user rename/delete
  action     String // dotted verb, e.g. "user.role.update", "user.view"
  targetType String? // "user" | "org" | "coachLink" | ...
  targetId   String? // the affected entity's id
  summary    String? // human-readable one-liner
  metadata   Json? // structured before/after + reason
  ip         String? // best-effort request IP
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
