{
  "name": "hybrid",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "turbo run dev --filter=@hybrid/web",
    "mobile": "turbo run dev --filter=@hybrid/mobile"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ],
    "patchedDependencies": {
      "@kingstinct/react-native-healthkit@14.0.2": "patches/@kingstinct__react-native-healthkit@14.0.2.patch"
    }
  }
}
