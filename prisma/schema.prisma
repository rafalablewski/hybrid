// HYBRID data model — Sprint 1.
// Postgres on Supabase. The permission model lives HERE (roles + CoachLink),
// not in the UI. Row-level security is enforced in Supabase / API middleware:
//   - a user reads/writes Session, Macrocycle, Biometric only WHERE userId = auth.uid()
//   - a coach reads a client's data only via an ACTIVE CoachLink
//   - private CoachNotes are never returned to the client
//   - admins read aggregates only — never another user's raw private rows

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for the app; direct connection for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum LinkStatus {
  PENDING
  ACTIVE
  ENDED
}

model User {
  id        String   @id @default(cuid())
  // Mirrors the Supabase auth.users id so RLS can match auth.uid().
  authId    String?  @unique
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT) // a user can be COACH and CLIENT at once
  language  String   @default("en")
  createdAt DateTime @default(now())

  sessions    Session[]
  macrocycles Macrocycle[]
  biometrics  Biometric[]
  signals     Signal[]
  connections Connection[]
  memberships Membership[]
  coachLinks  CoachLink[]  @relation("asClient")
  clientLinks CoachLink[]  @relation("asCoach")
}

// The mutual-consent coach↔client relationship. Authorization is by THIS,
// not by role label alone.
model CoachLink {
  id        String      @id @default(cuid())
  coach     User        @relation("asCoach", fields: [coachId], references: [id])
  coachId   String
  client    User        @relation("asClient", fields: [clientId], references: [id])
  clientId  String
  status    LinkStatus  @default(PENDING)
  createdAt DateTime    @default(now())
  notes     CoachNote[]

  @@unique([coachId, clientId])
  @@index([clientId])
  @@index([coachId])
}

model CoachNote {
  id        String    @id @default(cuid())
  link      CoachLink @relation(fields: [linkId], references: [id])
  linkId    String
  body      String
  private   Boolean   @default(false) // private notes the client never sees
  createdAt DateTime  @default(now())

  @@index([linkId])
}

model Session {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  title       String
  startedAt   DateTime
  completedAt DateTime?
  blocks      Json // exercises/sets/reps/load/rpe — matches the prototype block shape
  readiness   Int?

  @@index([userId])
}

model Macrocycle {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  goal      String
  eventDate DateTime?
  blocks    Json // meso/micro structure from buildMacrocycle()
  startedAt DateTime  @default(now())

  @@index([userId])
}

model Biometric {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime
  hrv       Float?
  restingHr Float?
  sleepH    Float?
  source    String // "apple" | "whoop" | ...

  @@index([userId])
}

// The Athlete Twin's universal time-series. Every measurement — recovery, GPS
// load, force-plate, blood, composition — lands here as ONE shape from any
// source, so the engines read a single stream (see @hybrid/core signal
// ontology). Generalizes Biometric; same own-rows RLS as Session/Biometric.
model Signal {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id])
  userId String
  kind   String // "hrv" | "restingHr" | "sleep" | "highSpeedRunning" | ...
  value  Float
  unit   String
  source String // "apple" | "whoop" | "garmin" | "catapult" | "manual" | ...
  ts     DateTime

  @@index([userId, kind, ts])
}

// ---- Org Graph (Team Operating System) ----------------------------------
// A club/federation as one governed org: a team hierarchy + staff with roles.
// Access is scoped by role + data sensitivity in @hybrid/core (org.ts) and
// enforced in the API; org membership gates org-level reads in RLS.
model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  teams       Team[]
  memberships Membership[]
}

model Team {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  parent    Team?        @relation("TeamTree", fields: [parentId], references: [id])
  parentId  String?
  children  Team[]       @relation("TeamTree")
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([parentId])
}

model Membership {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  role      String // OrgRole: OWNER | DIRECTOR | COACH | MEDICAL | ANALYST | ATHLETE
  teamId    String? // optional: scope this member to a team subtree
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// A connected wearable/sensor account. Tokens let the server sync provider
// data into the Signal ontology. Own-rows RLS (see reference SQL). Tokens
// should be encrypted at rest in production.
model Connection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  provider     String // "whoop" | "oura" | "garmin" | "apple" | ...
  status       String    @default("active") // "active" | "revoked" | "error"
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

// Pre-built plan library (admin-managed).
model Plan {
  id     String @id @default(cuid())
  goalId String
  name   String
  level  String
  detail Json // the PLAN_DETAIL shape from the prototype
}
