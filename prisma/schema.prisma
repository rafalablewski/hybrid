// HYBRID data model — Sprint 1.
// Postgres on Supabase. The permission model lives HERE (roles + CoachLink),
// not in the UI. Row-level security is enforced in Supabase / API middleware:
//   - a user reads/writes Session, Macrocycle, Biometric only WHERE userId = auth.uid()
//   - a coach reads a client's data only via an ACTIVE CoachLink
//   - private CoachNotes are never returned to the client
//   - admins read aggregates only — never another user's raw private rows

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for the app; direct connection for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum LinkStatus {
  PENDING
  ACTIVE
  ENDED
}

model User {
  id        String   @id @default(cuid())
  // Mirrors the Supabase auth.users id so RLS can match auth.uid().
  authId    String?  @unique
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT) // a user can be COACH and CLIENT at once
  language  String   @default("en")
  createdAt DateTime @default(now())

  // Billing — the paid "Full" entitlement. entitlement is mirrored into the
  // Supabase auth user_metadata so both clients read it from the session; these
  // columns are the server-side source of truth + the Stripe linkage.
  entitlement        String   @default("free") // free | paid
  stripeCustomerId   String?  @unique
  subscriptionStatus String?  // active | trialing | past_due | canceled | null

  sessions      Session[]
  macrocycles   Macrocycle[]
  biometrics    Biometric[]
  signals       Signal[]
  connections   Connection[]
  memberships   Membership[]
  rtpProtocols  RtpProtocol[]
  videos        VideoAnalysis[]
  events        Event[]
  talentProfile TalentProfile?
  riskOutcomes  RiskOutcome[]
  checkins      Checkin[]
  templates       WorkoutTemplate[]
  assignments     Assignment[]     @relation("assignmentAthlete")
  assignmentsMade Assignment[]     @relation("assignmentCoach")
  coachLinks    CoachLink[]     @relation("asClient")
  clientLinks   CoachLink[]     @relation("asCoach")
  adminAudits   AdminAudit[]    @relation("adminAuditActor")
}

// Admin-granted per-user feature access (nav ids) beyond the user's persona.
// Deliberately its OWN table (not a column on User) so the hot-path user lookup
// never depends on it — every read is soft-guarded, so the app runs fine before
// this migration is applied (the feature just no-ops). Layered into /api/flags.
model FeatureGrant {
  userId    String   @id
  navIds    String[] @default([])
  updatedAt DateTime @default(now()) @updatedAt
}

// A user's request for access to a feature beyond their persona. Admin approves
// → the navId is added to the user's FeatureGrant.navIds.
model AccessRequest {
  id        String    @id @default(cuid())
  userId    String
  userEmail String
  navId     String
  status    String    @default("pending") // pending | approved | denied
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@unique([userId, navId])
  @@index([status])
}

// A user's application to become a COACH. Admin approves → the user's role is
// promoted to COACH. Free-text credentials say who they are / certs / why.
model CoachApplication {
  id          String    @id @default(cuid())
  userId      String    @unique
  userEmail   String
  credentials String    // free-text: who they are / certs / why
  status      String    @default("pending") // pending | approved | denied
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([status])
}

// The mutual-consent coach↔client relationship. Authorization is by THIS,
// not by role label alone.
model CoachLink {
  id        String      @id @default(cuid())
  coach     User        @relation("asCoach", fields: [coachId], references: [id])
  coachId   String
  client    User        @relation("asClient", fields: [clientId], references: [id])
  clientId  String
  status    LinkStatus  @default(PENDING)
  tags      String[]    @default([]) // coach-authored labels for roster segmentation
  createdAt DateTime    @default(now())
  notes     CoachNote[]

  @@unique([coachId, clientId])
  @@index([clientId])
  @@index([coachId])
}

// The daily check-in — a personal training-readiness log. The client submits a
// structured self-report + a note each day; by default it's for their own use.
// A paid athlete may share a check-in with their coach, who then reads/replies
// via an ACTIVE CoachLink. Authored by the client (userId).
model Checkin {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  weekOf       DateTime // the day this check-in covers (midnight-normalized); legacy name
  bodyMassKg   Float?
  energy       Int? // 1–5 self-report
  sleep        Int? // 1–5
  soreness     Int? // 1–5 (5 = very sore)
  mood         Int? // 1–5
  adherencePct Int? // self-reported plan adherence 0–100
  note         String? // client free text
  coachReply   String? // coach response
  repliedAt    DateTime?
  // The daily check-in is for the athlete's own use by default; only a paid
  // athlete may opt to SHARE a check-in with their coach. A coach reads a
  // client's check-ins via an ACTIVE CoachLink AND only where this is true.
  sharedWithCoach Boolean @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// A reusable workout the coach (or athlete) builds once and assigns many times.
model WorkoutTemplate {
  id          String   @id @default(cuid())
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     String
  name        String
  description String?
  blocks      Json // SessionBlock[]
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// A workout scheduled to an athlete on a date. Blocks are a SNAPSHOT of the
// template at assignment time, so later edits to the template never change a
// workout already assigned. The athlete marks it complete (optionally linking
// the logged session).
model Assignment {
  id           String   @id @default(cuid())
  athlete      User     @relation("assignmentAthlete", fields: [athleteId], references: [id])
  athleteId    String
  assignedBy   User     @relation("assignmentCoach", fields: [assignedById], references: [id])
  assignedById String
  templateId   String?
  name         String
  blocks       Json // SessionBlock[] snapshot
  date         DateTime
  status       String   @default("assigned") // assigned | completed | skipped
  sessionId    String? // the logged Session that fulfilled it
  createdAt    DateTime @default(now())

  @@index([athleteId])
  @@index([assignedById])
}

model CoachNote {
  id        String    @id @default(cuid())
  link      CoachLink @relation(fields: [linkId], references: [id])
  linkId    String
  body      String
  private   Boolean   @default(false) // private notes the client never sees
  createdAt DateTime  @default(now())

  @@index([linkId])
}

model Session {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  title       String
  startedAt   DateTime
  completedAt DateTime?
  blocks      Json // exercises/sets/reps/load/rpe — matches the prototype block shape
  readiness   Int?
  // Soft-archive: the athlete can hide a workout from History without losing it
  // (recoverable), or hard-delete it outright. Archived rows are excluded from
  // the default History list + all engines, but kept for the audit trail.
  archivedAt  DateTime?

  @@index([userId])
}

// A workout logged BEFORE the athlete has an account (guest mode). The mobile
// client mirrors guest sessions here (best-effort, no auth) so an admin can see
// real product usage from people who haven't signed up yet. There is no userId —
// only an opaque per-device id. When the guest signs up, their on-device history
// is flushed into real Session rows; these anonymous rows are kept as-is.
model AnonSession {
  id        String   @id @default(cuid())
  deviceId  String? // opaque per-install id (not PII) — to group a device's logs
  platform  String? // "ios" | "android" | "web"
  title     String
  startedAt DateTime
  blocks    Json // same block shape as Session
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([createdAt])
}

model Macrocycle {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  goal      String
  eventDate DateTime?
  blocks    Json // meso/micro structure from buildMacrocycle()
  startedAt DateTime  @default(now())

  @@index([userId])
}

model Biometric {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime
  hrv       Float?
  restingHr Float?
  sleepH    Float?
  source    String // "apple" | "whoop" | ...

  @@index([userId])
}

// The Athlete Twin's universal time-series. Every measurement — recovery, GPS
// load, force-plate, blood, composition — lands here as ONE shape from any
// source, so the engines read a single stream (see @hybrid/core signal
// ontology). Generalizes Biometric; same own-rows RLS as Session/Biometric.
model Signal {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id])
  userId String
  kind   String // "hrv" | "restingHr" | "sleep" | "highSpeedRunning" | ...
  value  Float
  unit   String
  source String // "apple" | "whoop" | "garmin" | "catapult" | "manual" | ...
  ts     DateTime

  // de-dupe overlapping wearable syncs (same reading from the same source)
  @@unique([userId, kind, ts, source])
  @@index([userId, kind, ts])
}

// ---- Org Graph (Team Operating System) ----------------------------------
// A club/federation as one governed org: a team hierarchy + staff with roles.
// Access is scoped by role + data sensitivity in @hybrid/core (org.ts) and
// enforced in the API; org membership gates org-level reads in RLS.
model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  teams       Team[]
  memberships Membership[]
}

model Team {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  parent    Team?        @relation("TeamTree", fields: [parentId], references: [id])
  parentId  String?
  children  Team[]       @relation("TeamTree")
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([parentId])
}

model Membership {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  role      String // OrgRole: OWNER | DIRECTOR | COACH | MEDICAL | ANALYST | ATHLETE
  teamId    String? // optional: scope this member to a team subtree
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// A return-to-play protocol instance for an athlete + tissue. The gated stage
// progression lives in @hybrid/core (rtp.ts); this stores state + audit.
model RtpProtocol {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  tissue     String
  injuryDate DateTime
  stage      String   @default("acute")
  completed  Json // string[] of gate keys met in the current stage
  status     String   @default("active") // "active" | "cleared" | "abandoned"
  audit      Json     @default("[]") // append-only: who attested gates / advanced / overrode
  createdAt  DateTime @default(now())

  @@index([userId])
}

// A markerless motion-analysis result (pose capture is client/native; this
// stores the metrics from @hybrid/core video.ts). Derived asymmetry also lands
// in the Signal ontology.
model VideoAnalysis {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  movement  String
  metrics   Json // MotionAnalysis shape
  createdAt DateTime @default(now())

  @@index([userId])
}

// A target competition. The peaking optimizer (peaking.ts) back-solves the
// plan to land the athlete's best day on this date.
model Event {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  name      String
  sport     String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// An athlete's talent profile + benchmark inputs. Percentiles are computed in
// @hybrid/core (benchmarks.ts); visibility gates discovery (the talent market).
model TalentProfile {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  sport      String
  sex        String // "M" | "F"
  age        Int
  metrics    Json // { relStrength?, vo2?, durability?, hpi? }
  visibility String   @default("private") // "private" | "discoverable"
  // Moderation gate: a discoverable profile must be approved before it appears
  // in discovery. Existing rows default to approved (grandfathered); a new/edited
  // discoverable profile is set to pending by the API and enters the queue.
  moderationStatus String  @default("approved") // pending | approved | rejected
  moderationNote   String?
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([visibility])
  @@index([moderationStatus])
}

// A labeled risk outcome — the training signal for the injury calibration.
// Captured when an injury occurs (RTP opened) or fed in from medical records.
model RiskOutcome {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  tissue  String?
  score   Float // the heuristic risk score at the time
  injured Boolean
  ts      DateTime @default(now())

  @@index([userId])
}

// The active fitted model coefficients (e.g. injury calibration). Latest row
// per `key` is live; computeInjuryRisk applies it. Refit via the data network.
model ModelFit {
  id        String   @id @default(cuid())
  key       String // "injury-calibration"
  intercept Float
  slope     Float
  n         Int
  version   String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A pending invitation to join an org by email, for people who don't have an
// account yet. Claimed automatically on first sign-in (email match).
model OrgInvite {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  role      String
  teamId    String?
  status    String   @default("pending") // "pending" | "accepted" | "revoked"
  createdAt DateTime @default(now())

  @@unique([orgId, email])
  @@index([email])
}

// A connected wearable/sensor account. Tokens let the server sync provider
// data into the Signal ontology. Own-rows RLS (see reference SQL). Tokens
// should be encrypted at rest in production.
model Connection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  provider     String // "whoop" | "oura" | "garmin" | "apple" | ...
  status       String    @default("active") // "active" | "revoked" | "error"
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

// Pre-built plan library (admin-managed).
model Plan {
  id     String @id @default(cuid())
  goalId String
  name   String
  level  String
  detail Json // the PLAN_DETAIL shape from the prototype
}

// Admin-authored broadcast message surfaced in-app (the first CMS content type).
// Authored + published from the admin console; read by clients via the API.
// Mutations are server-only (admin-gated + audited); RLS lets any signed-in user
// read only PUBLISHED rows (reference/sql-announcement.sql), defense-in-depth.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String // plain text / light markdown
  level       String    @default("info") // "info" | "success" | "warning"
  audience    String    @default("all") // "all" | "coaches" | "clients"
  status      String    @default("draft") // "draft" | "published" | "archived"
  pinned      Boolean   @default(false) // show as a dismissible banner
  publishAt   DateTime? // scheduled go-live; null = live the moment it's published
  expiresAt   DateTime? // auto-hide after this instant; null = no expiry
  authorId    String // the admin who created it (no relation — survives user delete)
  authorEmail String // denormalized for the audit trail / display
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishAt])
}

// Admin-managed exercise library (CMS content type #2). A SUPERSET of the core
// Movement shape: the engine-critical fields (pattern/muscles/baseLoad/system)
// PLUS authored content (cues, equipment, demo video, aliases). The 9 built-in
// movements stay in @hybrid/core (engines stay pure); this table holds CUSTOM
// exercises + overrides, merged over the built-ins by name at read time
// (mergeMovements). Mutations server-only + audited; RLS lets signed-in users
// read only PUBLISHED rows (reference/sql-exercise.sql).
model Exercise {
  id      String @id @default(cuid())
  slug    String @unique // stable id, e.g. "back-squat"
  name    String @unique // display name = the engine key, e.g. "Back Squat"

  // engine-critical (mirror core Movement; validated against the core enums)
  pattern  String // squat | hinge | push | pull | lunge | carry | core | cond
  muscles  String[] // MuscleGroup[] (quads/glutes/posterior/back/chest/shoulders/triceps)
  baseLoad Float? // kg working baseline; null for conditioning
  system   String? // anaerobic | threshold | aerobic | null

  // CMS content
  kind        String   @default("strength") // strength | conditioning
  category    String? // library grouping, e.g. "Lower", "Olympic"
  equipment   String[] // ["barbell","rack"]
  aliases     String[] // alternate names → resolve renames + logged free-text
  description String?
  cues        String[] // coaching cues
  videoUrl    String? // demo clip (the blocked video library plugs in here)
  thumbUrl    String?

  // lifecycle / provenance
  status      String   @default("published") // draft | published | archived
  source      String   @default("custom") // builtin | custom
  authorId    String?
  authorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// Admin-managed media library (CMS content #3): the shared asset catalog
// (exercise demo clips, announcement imagery, …). The bytes live in a PUBLIC
// Supabase Storage bucket "media" (admin-only writes via is_admin() RLS); this
// table is the catalog — title/alt/tags/lifecycle + the stable public URL other
// content (an Exercise's videoUrl) points at. Mutations server-only + audited;
// RLS lets signed-in users read only PUBLISHED rows (reference/sql-media-library.sql).
model MediaAsset {
  id          String   @id @default(cuid())
  path        String   @unique // object path within the media bucket
  url         String // stable public URL (the bucket is public-read)
  title       String
  alt         String? // caption / accessibility text
  kind        String   @default("image") // image | video | other
  contentType String?
  sizeBytes   Int?
  width       Int?
  height      Int?
  tags        String[] // search/filtering
  status      String   @default("published") // draft | published | archived
  authorId    String?
  authorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([kind])
}

// Admin-authored localization override (CMS content #4). A SPARSE layer over the
// shipped TRANSLATIONS in @hybrid/core: one row per (lang, key) an admin edited
// or added. The clients load these and layer them over the baseline via
// makeTWithOverrides, so a non-engineer can fix copy or fill a missing PL/DE
// string without a deploy. Mutations server-only + audited; RLS lets signed-in
// users read all rows (reference/sql-translation.sql).
model Translation {
  id             String   @id @default(cuid())
  lang           String // en | pl | de
  key            String // dotted key, e.g. "nav.today"
  value          String
  updatedById    String?
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([lang, key])
  @@index([lang])
}

// Admin-authored feature-flag override (CMS content #5: runtime config). A
// SPARSE layer over the FEATURE_FLAGS registry in @hybrid/core — one row per flag
// an admin toggled / scoped / configured. The clients read the evaluated flags
// from /api/flags; code gates on them. Mutations server-only + audited; RLS lets
// signed-in users read all rows (reference/sql-feature-flags.sql).
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique // matches a FEATURE_FLAGS registry key
  enabled        Boolean  @default(true)
  audience       String   @default("all") // all | coaches | clients | admins
  value          Json? // optional config payload
  updatedById    String?
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled])
}

// The editable definition of one AI executive agent (CEO/CFO/CMO/COO + custom).
// The KNOWN role presets live in @hybrid/core (so the org has working defaults
// with an empty DB); this table stores the admin's edits — mandate, KPIs,
// responsibilities, guardrails, model/effort, status. buildSystemPrompt() in
// core turns a row into the live prompt. Mutations are server-only (ADMIN-gated
// + audited); reads are admin-only via the API. JSON columns are arrays.
model AgentConfig {
  id                  String   @id @default(cuid())
  role                String // "CEO" | "CFO" | … | custom label
  name                String
  status              String   @default("draft") // draft | active | paused
  model               String   @default("claude-opus-4-8")
  effort              String   @default("high") // low | medium | high | xhigh | max
  authority           String   @default("functional") // executive | functional | advisor
  reportsTo           String? // supervisor role/name; null = reports to the admin
  mandate             String
  responsibilities    Json     @default("[]") // string[]
  kpis                Json     @default("[]") // { metric, target }[]
  guardrails          Json     @default("[]") // string[]
  escalationThreshold String   @default("")
  tone                String   @default("")
  collaborators       Json     @default("[]") // string[]
  tools               Json     @default("[]") // string[]
  runtime             String   @default("messages") // messages | managed
  managedAgentId      String? // Claude Managed Agents agent id (created lazily, reused)
  memoryStoreId       String? // durable memory store id (created lazily, reused)
  approvalThresholdUsd Float   @default(0) // require 2nd-operator approval when est. run cost ≥ this (0 = off)
  budgetUsd7d         Float    @default(0) // auto-pause when trailing-7d spend ≥ this (0 = off)
  updatedById         String?
  updatedByEmail      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
}

// One execution of an agent — the run history / transcript. Written server-side
// by the run + stream routes (best-effort; never blocks the run). Read is
// admin-only via the API. Denormalized agent role/name so it survives edits.
model AgentRun {
  id           String   @id @default(cuid())
  agentId      String
  agentRole    String
  agentName    String
  task         String
  output       String // final synthesized output
  steps        Json     @default("[]") // delegation trace: { agent, role, task, output }[]
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  status       String   @default("ok") // ok | error
  runtime      String   @default("messages") // messages | managed
  ranById      String?
  ranByEmail   String?
  createdAt    DateTime @default(now())

  @@index([agentId, createdAt])
}

// A standing task that runs an agent on a cadence. The cron route (/api/cron/
// agents) picks up enabled schedules whose nextRunAt is due, runs the agent, and
// rolls nextRunAt forward. Server-only writes (ADMIN-gated API); deny-by-default.
model AgentSchedule {
  id             String    @id @default(cuid())
  agentId        String
  task           String
  cadence        String    @default("daily") // hourly | daily | weekly
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([agentId])
}

// A recorded numeric actual for one of an agent's KPIs, over time — the "actual"
// side of the target-vs-actual scorecard. Logged by an admin (or, later, an
// agent). Server-only writes; deny-by-default RLS.
model AgentKpiMeasurement {
  id              String   @id @default(cuid())
  agentId         String
  metric          String // matches a Kpi.metric on the agent
  value           Float
  note            String?
  recordedById    String?
  recordedByEmail String?
  createdAt       DateTime @default(now())

  @@index([agentId, metric, createdAt])
}

// A run held for a second operator's approval (two-person control). Created when
// an agent's estimated run cost crosses its approvalThresholdUsd; a DIFFERENT
// operator approves (which executes it) or denies. Server-only; deny-by-default.
model AgentApproval {
  id               String    @id @default(cuid())
  agentId          String
  agentName        String
  task             String
  estimateUsd      Float     @default(0)
  runtime          String    @default("messages")
  status           String    @default("pending") // pending | approved | denied
  requestedById    String?
  requestedByEmail String?
  decidedById      String?
  decidedByEmail   String?
  runId            String? // the AgentRun produced once approved + executed
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?

  @@index([status, createdAt])
}

// A persistent, dismissible notification for the Agent HQ inbox (e.g. a failed
// run). Written best-effort when the event happens; marked read by the admin.
// Server-only; deny-by-default RLS.
model AgentNotification {
  id        String   @id @default(cuid())
  kind      String // run_failed | …
  agentId   String?
  agentName String?
  title     String
  body      String?
  severity  String   @default("warning") // info | warning | error
  read      Boolean  @default(false)
  refId     String? // related entity (e.g. AgentRun id)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// A user-submitted content report — the second feeder of the admin moderation
// queue (alongside discoverable talent profiles awaiting approval). Denormalized
// (no FK relations, like AdminAudit) so it survives a reporter/target delete.
// Filed by any signed-in user; resolved by a moderator. Server-only reads.
model Report {
  id              String    @id @default(cuid())
  reporterId      String
  reporterEmail   String
  targetType      String // "talentProfile" | …
  targetId        String
  reason          String // inappropriate | fake | spam | other
  detail          String?
  status          String    @default("open") // open | resolved | dismissed
  resolution      String? // moderator note
  resolvedById    String?
  resolvedByEmail String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

// Append-only record of every privileged action taken in the admin panel.
// Written server-side by the /api/admin/* routes (never by a client). Read is
// admin-only. This is the institutional accountability layer: who did what, to
// whom, when, and what changed. Never deleted or mutated.
model AdminAudit {
  id         String   @id @default(cuid())
  actor      User     @relation("adminAuditActor", fields: [actorId], references: [id])
  actorId    String
  actorEmail String // denormalized so the log survives a user rename/delete
  action     String // dotted verb, e.g. "user.role.update", "user.view"
  targetType String? // "user" | "org" | "coachLink" | ...
  targetId   String? // the affected entity's id
  summary    String? // human-readable one-liner
  metadata   Json? // structured before/after + reason
  ip         String? // best-effort request IP
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
