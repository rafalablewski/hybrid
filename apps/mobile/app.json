{
  "expo": {
    "name": "HYBRID",
    "slug": "hybrid",
    "scheme": "hybrid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0c0d0c",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hybriddomain.xyz",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.hybrid.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0d0c"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0c0d0c"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HYBRID uses your photo library so you can add progress photos.",
          "cameraPermission": "HYBRID uses the camera so you can take progress photos."
        }
      ],
      "react-native-iap"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
