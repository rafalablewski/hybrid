{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    // The architecture guards (catalog attribution, e1rm-headline) read source
    // files off disk, so the test build needs Node builtins.
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
